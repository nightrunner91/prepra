---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";
import { withBase } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
  currentSection?: string;
  theme?: "theory" | "practice" | "interview";
  showFooter?: boolean;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = "Платформа для подготовки к техническому собеседованию: от фронтенда к Product Engineer",
  currentSection,
  theme = "theory",
  showFooter = true,
  image = "/og-cover.jpg",
  jsonLd,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://prepra.up.railway.app");
const fullTitle = `${title} | Prepra`;
const canonicalUrl = new URL(Astro.url.pathname, site);
if (!canonicalUrl.pathname.endsWith("/")) canonicalUrl.pathname += "/";
const canonical = canonicalUrl.href;
const imageUrl = new URL(withBase(image), site).href;
const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="ru" class={`theme-${theme}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Иконки: SVG — основной источник, ICO и PNG — запасные пути.
         Мастер-файлы и размеры собирает scripts/generate-favicons.mjs. -->
    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={withBase("/favicon-48x48.png")}
    />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
    <link rel="mask-icon" href={withBase("/safari-pinned-tab.svg")} color="#85E65B" />
    <link rel="manifest" href={withBase("/manifest.json")} />

    <meta name="theme-color" content="#F2F2EC" />
    <meta name="application-name" content="Prepra" />
    <meta name="apple-mobile-web-app-title" content="Prepra" />
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prepra" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Prepra — подготовка к собеседованию фронтенд-разработчика"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}

    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute(
            "content",
            document.documentElement.classList.contains("dark") ? "#0A0A0A" : "#F2F2EC",
          );
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-text">
    <div class="flex min-h-screen flex-col">
      <Header />
      <MobileNav currentSection={currentSection} />

      <main id="main" tabindex="-1" class="flex-1 outline-none">
        <slot />
      </main>

      {showFooter && <Footer />}
    </div>
  </body>
</html>
