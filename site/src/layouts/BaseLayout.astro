---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileNav from "../components/layout/MobileNav.astro";

interface Props {
  title: string;
  description?: string;
  currentSection?: string;
  showFooter?: boolean;
}

const {
  title,
  description = "Учебная платформа для изучения React и JavaScript",
  currentSection,
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="ru" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Prepra</title>
    <script is:inline>
      (function () {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-text">
    <div class="flex min-h-screen flex-col">
      <Header currentSection={currentSection} />
      <MobileNav currentSection={currentSection} />

      <main class="flex-1">
        <slot />
      </main>

      {showFooter && <Footer />}
    </div>
  </body>
</html>

<script>
  (async () => {
    const blocks = document.querySelectorAll("pre[data-language='mermaid']");
    if (!blocks.length) return;

    const { default: mermaid } = await import("mermaid");

    const sources: Array<{ container: HTMLElement; source: string }> = [];

    blocks.forEach((pre) => {
      const code = pre.querySelector("code");
      const source = code?.textContent ?? "";
      const wrapper = document.createElement("div");
      wrapper.dataset.mermaidWrapper = "";
      pre.replaceWith(wrapper);
      sources.push({ container: wrapper, source });
    });

    function buildConfig(dark: boolean) {
      return {
        startOnLoad: false,
        theme: "base" as const,
        themeVariables: dark
          ? {
              primaryColor: "#1C1C1C",
              primaryBorderColor: "#FFFFFF",
              primaryTextColor: "#F0F0F0",
              lineColor: "#FFFFFF",
              secondaryColor: "#0A0A0A",
              tertiaryColor: "#24292e",
              clusterBkg: "#0A0A0A",
              clusterBorder: "#FFFFFF",
              edgeLabelBackground: "#0A0A0A",
              noteBkgColor: "#1F1A05",
              noteTextColor: "#FACC15",
              actorBkg: "#1C1C1C",
              actorBorder: "#FFFFFF",
              actorTextColor: "#F0F0F0",
              actorLineColor: "#FFFFFF",
              signalColor: "#FFFFFF",
              fontFamily: '"JetBrains Mono", "Space Mono", monospace',
              fontSize: "13px",
            }
          : {
              primaryColor: "#E8E8E0",
              primaryBorderColor: "#000000",
              primaryTextColor: "#000000",
              lineColor: "#000000",
              secondaryColor: "#F2F2EC",
              tertiaryColor: "#FFFFFF",
              clusterBkg: "#F2F2EC",
              clusterBorder: "#000000",
              edgeLabelBackground: "#F2F2EC",
              noteBkgColor: "#FFF3BF",
              noteTextColor: "#854D0E",
              actorBkg: "#E8E8E0",
              actorBorder: "#000000",
              actorTextColor: "#000000",
              actorLineColor: "#000000",
              signalColor: "#000000",
              fontFamily: '"JetBrains Mono", "Space Mono", monospace',
              fontSize: "13px",
            },
      };
    }

    async function render() {
      const isDark = document.documentElement.classList.contains("dark");
      mermaid.initialize(buildConfig(isDark));

      for (const { container, source } of sources) {
        const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;
        try {
          const { svg } = await mermaid.render(id, source);
          container.innerHTML = svg;
        } catch (e) {
          console.error("Mermaid render error:", e);
        }
      }
    }

    await render();

    new MutationObserver(render).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  })();
</script>
