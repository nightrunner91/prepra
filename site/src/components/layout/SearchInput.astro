---
import { MagnifyingGlass } from "@phosphor-icons/react";
---

<div class="relative hidden sm:block">
  <button
    type="button"
    data-open-search
    aria-label="Поиск по сайту"
    aria-haspopup="dialog"
    class="flex h-10 w-20 items-center gap-2 border-2 border-border bg-surface pl-2.5 pr-2 text-left eyebrow text-text-tertiary transition-colors hover:border-accent-strong hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-strong lg:w-44 xl:w-48"
  >
    <MagnifyingGlass size={16} weight="bold" className="shrink-0" />
    <span class="flex-1 truncate">Поиск</span>
    <kbd
      class="hidden shrink-0 items-center gap-1 border border-border bg-canvas px-1.5 py-0.5 text-xs leading-none text-text-tertiary xl:inline-flex"
      aria-hidden="true"
    >
      <span>Ctrl</span><span>K</span>
    </kbd>
  </button>
</div>
