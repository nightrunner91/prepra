---
import { sections } from "../../lib/sections";
import { withBase } from "../../lib/urls";

const tabs = [
  { id: "theory", label: "Теория", href: withBase("/theory") },
  { id: "practice", label: "Практика", href: withBase("/practice") },
  { id: "interview", label: "Интервью", href: withBase("/interview") },
];

const pathname = Astro.url.pathname.replace(/\/+$/, "");

const isTheoryPage =
  pathname === withBase("/theory") ||
  sections.some(
    (section) =>
      pathname === withBase(`/${section.id}`) ||
      pathname.startsWith(withBase(`/${section.id}/`)),
  );

const activePage = pathname === withBase("/practice")
  ? "practice"
  : pathname === withBase("/interview")
    ? "interview"
    : isTheoryPage
      ? "theory"
      : undefined;
---

<nav
  aria-label="Разделы платформы"
  class="hidden items-center gap-5 lg:flex"
>
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        aria-current={activePage === tab.id ? "page" : undefined}
        class="border-b-2 border-transparent pb-0.5 font-mono text-xs font-bold uppercase tracking-wider text-text-secondary transition-colors hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-[current=page]:border-accent aria-[current=page]:text-text"
      >
        {tab.label}
      </a>
    ))
  }
</nav>
