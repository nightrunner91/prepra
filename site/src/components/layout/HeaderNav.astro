---
import { getActivePage } from "../../lib/nav";
import { withBase } from "../../lib/urls";

const tabs = [
  { id: "theory", label: "Теория", href: withBase("/theory") },
  { id: "practice", label: "Практика", href: withBase("/practice") },
  { id: "interview", label: "Интервью", href: withBase("/interview") },
];

const activePage = getActivePage(Astro.url.pathname);
---

<nav
  aria-label="Разделы платформы"
  class="hidden justify-self-center items-center gap-3 lg:flex"
>
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        aria-current={activePage === tab.id ? "page" : undefined}
        class="inline-flex items-center px-4 py-2 font-mono text-base font-extrabold uppercase tracking-wide text-text transition-opacity duration-100 hover:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-strong aria-[current=page]:bg-accent aria-[current=page]:text-accent-ink aria-[current=page]:hover:opacity-100"
      >
        {tab.label}
      </a>
    ))
  }
</nav>
