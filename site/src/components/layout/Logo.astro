---
/**
 * Логотип Prepra. SVG встроен в разметку, чтобы правая часть «Pra»
 * окрашивалась в цвет активного раздела.
 */
import { getActivePage } from "../../lib/nav";

interface Props {
  class?: string;
}

const { class: className = "h-9" } = Astro.props;

const activePage = getActivePage(Astro.url.pathname);
const praFill = activePage
  ? `var(--color-${activePage}-strong)`
  : "var(--color-text-tertiary)";
---

