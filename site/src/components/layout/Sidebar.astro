---
import { withBase } from "../../lib/urls";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;

const sections = [
  { id: "javascript", label: "JavaScript", desc: "Основы, ES6+, замыкания" },
  { id: "typescript", label: "TypeScript", desc: "Типизация, дженерики" },
  { id: "react", label: "React", desc: "Хуки, паттерны" },
  { id: "nextjs", label: "Next.js", desc: "Роутинг, SSR" },
  { id: "testing", label: "Тестирование", desc: "Unit, E2E, моки" },
  { id: "html-css", label: "HTML и CSS", desc: "Семантика, layout" },
  {
    id: "performance",
    label: "Производительность",
    desc: "Метрики, оптимизация",
  },
  { id: "architecture", label: "Архитектура", desc: "Паттерны, SOLID" },
  {
    id: "state-management",
    label: "Управление состоянием",
    desc: "Zustand, TanStack",
  },
  { id: "algorithms", label: "Алгоритмы", desc: "Big O, структуры" },
  { id: "api-communication", label: "API", desc: "REST, GraphQL" },
  {
    id: "build-and-deployment",
    label: "Сборка и деплой",
    desc: "CI/CD, бандлы",
  },
  { id: "platforms", label: "Платформы", desc: "PWA, React Native" },
  { id: "security", label: "Безопасность", desc: "XSS, CSRF, CSP" },
];
---

<aside
  class="fixed top-14 left-0 w-56 h-[calc(100vh-3.5rem)] overflow-y-auto border-r border-border py-6 px-3"
>
  <div class="space-y-0.5">
    {
      sections.map((s) => (
        <a
          href={withBase(`/${s.id}`)}
          class={`block rounded-[5px] px-3 py-2 text-[13px] transition-colors ${
            currentSection === s.id
              ? "bg-surface-alt text-text font-medium"
              : "text-text-secondary hover:text-accent hover:bg-surface-alt/50"
          }`}
        >
          <span class="block">{s.label}</span>
          <span class="block text-sm text-text-tertiary font-normal mt-0.5">
            {s.desc}
          </span>
        </a>
      ))
    }
  </div>
</aside>
