---
import { withBase } from '../../lib/urls';

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;

const sections = [
  { id: 'javascript', label: 'JavaScript', desc: 'Основы, ES6+, замыкания' },
  { id: 'typescript', label: 'TypeScript', desc: 'Типизация, дженерики' },
  { id: 'react', label: 'React', desc: 'Хуки, паттерны' },
  { id: 'nextjs', label: 'Next.js', desc: 'Роутинг, SSR' },
  { id: 'testing', label: 'Testing', desc: 'Unit, E2E, моки' },
  { id: 'html-css', label: 'HTML & CSS', desc: 'Семантика, layout' },
  { id: 'performance', label: 'Performance', desc: 'Метрики, оптимизация' },
  { id: 'architecture', label: 'Architecture', desc: 'Паттерны, SOLID' },
  { id: 'state-management', label: 'State Mgmt', desc: 'Zustand, TanStack' },
  { id: 'algorithms', label: 'Algorithms', desc: 'Big O, структуры' },
  { id: 'api-communication', label: 'API', desc: 'REST, GraphQL' },
  { id: 'build-and-deployment', label: 'Build/Deploy', desc: 'CI/CD, бандлы' },
  { id: 'platforms', label: 'Platforms', desc: 'PWA, React Native' },
  { id: 'security', label: 'Security', desc: 'XSS, CSRF, CSP' },
];
---

<aside class="hidden lg:block w-56 flex-shrink-0 border-r border-border">
  <nav class="sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto py-6 px-3">
    <div class="space-y-0.5">
      {sections.map((s) => (
        <a
          href={withBase(`/${s.id}`)}
          class={`block rounded-[5px] px-3 py-2 text-[13px] transition-colors ${
            currentSection === s.id
              ? 'bg-surface-alt text-text font-medium'
              : 'text-text-secondary hover:text-text hover:bg-surface-alt/50'
          }`}
        >
          <span class="block">{s.label}</span>
          <span class="block text-[11px] text-text-tertiary font-normal mt-0.5">{s.desc}</span>
        </a>
      ))}
    </div>
  </nav>
</aside>
