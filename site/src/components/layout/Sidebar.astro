---
import { Barbell, Microphone } from "@phosphor-icons/react";
import { sections } from "../../lib/sections";
import { withBase } from "../../lib/urls";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;
---

<aside
  class="fixed top-14 left-0 w-56 h-[calc(100vh-3.5rem)] flex flex-col overflow-y-auto border-r-[3px] border-border py-6 px-3 bg-canvas"
>
  <nav class="space-y-0">
    {
      sections.map((s) => {
        const Icon = s.icon;
        return (
          <a
            href={withBase(`/${s.id}`)}
            class={`flex items-center gap-2 border-b-2 border-border px-3 py-2.5 text-[13px] font-bold uppercase tracking-wide transition-colors ${
              currentSection === s.id
                ? "bg-text text-canvas"
                : "text-text-secondary hover:bg-surface-alt hover:text-text"
            }`}
          >
            <Icon size={16} class="shrink-0" />
            <span>{s.label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="mt-auto space-y-2 pt-6">
    <a
      href={withBase("/practice")}
      class="flex items-center gap-2 border-2 border-border bg-pale-yellow-bg px-3 py-2.5 text-[13px] font-bold uppercase tracking-wide text-pale-yellow-text transition-colors hover:bg-pale-yellow-bg-hover hover:text-pale-yellow-text-hover"
    >
      <Barbell size={16} weight="bold" class="shrink-0" />
      <span>Практикум</span>
    </a>
    <a
      href={withBase("/interview")}
      class="flex items-center gap-2 border-2 border-accent bg-pale-green-bg px-3 py-2.5 text-[13px] font-bold uppercase tracking-wide text-pale-green-text transition-colors hover:bg-pale-green-bg-hover hover:text-pale-green-text-hover"
    >
      <Microphone size={16} weight="bold" class="shrink-0" />
      <span>Мок-интервью</span>
    </a>
  </div>
</aside>
