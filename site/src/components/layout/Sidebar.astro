---
import { sections } from "../../lib/sections";
import { withBase } from "../../lib/urls";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;
---

<aside
  class="fixed bottom-0 left-0 top-[var(--header-offset)] flex w-56 flex-col overflow-y-auto border-r-[3px] border-border bg-canvas px-3 py-6"
>
  <nav class="space-y-0">
    {
      sections.map((s) => {
        const Icon = s.icon;
        return (
          <a
            href={withBase(`/${s.id}`)}
            aria-current={currentSection === s.id ? "page" : undefined}
            class={`flex items-center gap-2 border-b-2 border-border px-3 py-2.5 text-[13px] font-bold uppercase tracking-wide transition-colors ${
              currentSection === s.id
                ? "bg-text text-canvas"
                : "text-text-secondary hover:bg-surface-alt hover:text-text"
            }`}
          >
            <Icon size={16} class="shrink-0" />
            <span>{s.label}</span>
          </a>
        );
      })
    }
  </nav>
</aside>
