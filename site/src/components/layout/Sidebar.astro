---
import {
  Atom,
  BracketsCurly,
  Brain,
  CheckSquare,
  Code,
  Database,
  Devices,
  FileCode,
  Lightning,
  Package,
  PlugsConnected,
  Rocket,
  Shield,
  TreeStructure,
} from "@phosphor-icons/react";
import { withBase } from "../../lib/urls";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;

const sections = [
  { id: "javascript", label: "JavaScript", icon: Code },
  { id: "typescript", label: "TypeScript", icon: BracketsCurly },
  { id: "react", label: "React", icon: Atom },
  { id: "nextjs", label: "Next.js", icon: Rocket },
  { id: "testing", label: "Тестирование", icon: CheckSquare },
  { id: "html-css", label: "HTML и CSS", icon: FileCode },
  { id: "performance", label: "Производительность", icon: Lightning },
  { id: "architecture", label: "Архитектура", icon: TreeStructure },
  { id: "state-management", label: "Хранилища", icon: Database },
  { id: "api-communication", label: "API", icon: PlugsConnected },
  { id: "build-and-deployment", label: "Сборка и деплой", icon: Package },
  { id: "platforms", label: "Платформы", icon: Devices },
  { id: "security", label: "Безопасность", icon: Shield },
  { id: "ai", label: "AI и LLM", icon: Brain },
];
---

<aside
  class="fixed top-14 left-0 w-56 h-[calc(100vh-3.5rem)] overflow-y-auto border-r border-border py-6 px-3"
>
  <div class="space-y-0.5">
    {
      sections.map((s) => {
        const Icon = s.icon;
        return (
          <a
            href={withBase(`/${s.id}`)}
            class={`flex items-center gap-2 rounded-[5px] px-3 py-2 text-[14px] transition-colors ${
              currentSection === s.id
                ? "bg-surface-alt text-text font-medium"
                : "text-text-secondary hover:text-accent hover:bg-surface-alt/50"
            }`}
          >
            <Icon size={16} class="shrink-0" />
            <span>{s.label}</span>
          </a>
        );
      })
    }
  </div>
</aside>
