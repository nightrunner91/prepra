---
import type { Icon } from "@phosphor-icons/react";

interface Props {
  title: string;
  /** Знак раздела: иконка в штампе перед заголовком. */
  icon?: Icon;
  lede?: string;
  /** Метрики каталога под заголовком раздела. */
  stats?: Array<{ value: number; label: string }>;
  class?: string;
}

const {
  title,
  icon: Icon,
  lede,
  stats = [],
  class: className = "",
} = Astro.props;

const hasActions = Astro.slots.has("actions");
const hasAside = Astro.slots.has("aside");
const hasStats = stats.length > 0;
---

<div class:list={["page-shell", className]}>
  <header class:list={[hasAside ? "masthead" : "page-head"]}>
    <div class:list={[hasAside && "masthead-grid lg:gap-6"]}>
      <div class:list={[hasAside ? "masthead-main" : "min-w-0"]}>
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
          <div class="min-w-0">
            <div class="page-head-row">
              {
                Icon && (
                  <span class="page-title-mark" aria-hidden="true">
                    <Icon
                      size={22}
                      weight="bold"
                      className="size-5 lg:size-6"
                    />
                  </span>
                )
              }
              <h1 class="page-title">{title}</h1>
            </div>
            {lede && <p class="page-lede">{lede}</p>}
          </div>

          {
            hasActions && (
              <div class="flex flex-wrap items-center gap-2">
                <slot name="actions" />
              </div>
            )
          }
        </div>

        {
          hasStats && (
            <ul
              class:list={[
                "masthead-stats",
                hasAside ? "mt-auto pt-4 lg:pt-6" : "mt-4",
              ]}
            >
              {stats.map((stat) => (
                <li class="masthead-stat">
                  <span class="masthead-stat-value">{stat.value}</span>
                  <span>{stat.label}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        hasAside && (
          <div class="masthead-aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </header>

  <slot />
</div>
