---
import { sections } from "../../lib/sections";
import { withBase } from "../../lib/urls";
import { X } from "@phosphor-icons/react";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;
---

<div
  id="mobile-drawer"
  class="fixed inset-y-0 right-0 z-50 w-72 translate-x-full border-l-[3px] border-border bg-canvas transition-transform duration-200 ease-in-out lg:hidden"
>
  <div
    class="flex items-center justify-between border-b-[3px] border-border px-4 h-14"
  >
    <span class="font-mono text-lg font-extrabold uppercase tracking-tight text-text">Навигация</span>
    <button
      id="mobile-drawer-close"
      class="flex items-center justify-center h-9 w-9 border-2 border-border text-text hover:bg-text hover:text-canvas transition-colors"
      aria-label="Close menu"
    >
      <X size={18} weight="bold" />
    </button>
  </div>
  <nav class="overflow-y-auto h-[calc(100vh-3.5rem)] py-4 px-3">
    <div class="space-y-0">
      {
        sections.map((s) => (
          <a
            href={withBase(`/${s.id}`)}
            class={`block border-b-2 border-border px-3 py-3 text-sm font-bold uppercase tracking-wide transition-colors ${
              currentSection === s.id
                ? "bg-text text-canvas"
                : "text-text-secondary hover:bg-surface-alt hover:text-text"
            }`}
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </nav>
</div>

<div
  id="mobile-drawer-overlay"
  class="fixed inset-0 z-40 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-200 lg:hidden"
>
</div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const drawer = document.getElementById("mobile-drawer");
  const overlay = document.getElementById("mobile-drawer-overlay");
  const closeBtn = document.getElementById("mobile-drawer-close");

  function openDrawer() {
    drawer?.classList.remove("translate-x-full");
    drawer?.classList.add("translate-x-0");
    overlay?.classList.remove("opacity-0", "pointer-events-none");
    overlay?.classList.add("opacity-100");
  }

  function closeDrawer() {
    drawer?.classList.add("translate-x-full");
    drawer?.classList.remove("translate-x-0");
    overlay?.classList.add("opacity-0", "pointer-events-none");
    overlay?.classList.remove("opacity-100");
  }

  btn?.addEventListener("click", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  overlay?.addEventListener("click", closeDrawer);
</script>
