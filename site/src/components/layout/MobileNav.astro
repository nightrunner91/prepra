---
import { sections } from "../../lib/sections";
import { withBase } from "../../lib/urls";
import { topLevelCounts } from "../../lib/top-level-counts";
import {
  Barbell,
  BookOpen,
  Microphone,
  X,
} from "@phosphor-icons/react";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;

const tabs = [
  { id: "theory", label: "Теория", icon: BookOpen },
  { id: "practice", label: "Практика", icon: Barbell },
  { id: "interview", label: "Интервью", icon: Microphone },
] as const;

const pathname = Astro.url.pathname.replace(/\/+$/, "");
const activeTab = pathname.endsWith("/practice")
  ? "practice"
  : pathname.endsWith("/interview")
    ? "interview"
    : undefined;
---

<div
  id="mobile-drawer"
  class="fixed inset-y-0 right-0 z-[100] w-72 translate-x-full border-l-[3px] border-border bg-canvas transition-transform duration-200 ease-in-out lg:hidden"
>
  <div
    class="flex items-center justify-between border-b-[3px] border-border px-4 h-[59px]"
  >
    <span
      class="font-mono text-lg font-extrabold uppercase tracking-tight text-text"
      >Навигация</span
    >
    <button
      id="mobile-drawer-close"
      class="flex items-center justify-center h-9 w-9 border-2 border-border text-text hover:bg-text hover:text-canvas transition-colors"
      aria-label="Close menu"
    >
      <X size={18} weight="bold" />
    </button>
  </div>
  <nav class="flex h-[calc(100vh-3.5rem)] flex-col overflow-y-auto py-4 px-3">
    <div class="space-y-0">
      {
        tabs.map((tab) => {
          const Icon = tab.icon;
          return (
            <a
              href={`${withBase("/")}#${tab.id}`}
              data-top-tab={tab.id}
              aria-current={activeTab === tab.id ? "page" : undefined}
              class="flex items-center gap-2 border-b-2 border-border px-3 py-3 text-sm font-bold uppercase tracking-wide text-text-secondary transition-colors hover:bg-surface-alt hover:text-text aria-[current=page]:bg-text aria-[current=page]:text-canvas"
            >
              <Icon size={16} weight="bold" class="shrink-0" />
              <span>{tab.label}</span>
              <span
                aria-hidden="true"
                class="ml-auto text-[10px] tabular-nums opacity-50"
              >
                {topLevelCounts[tab.id]}
              </span>
            </a>
          );
        })
      }
    </div>
    <div class="mt-4 space-y-0">
      {
        sections.map((s) => {
          const Icon = s.icon;
          return (
            <a
              href={withBase(`/${s.id}`)}
              class={`flex items-center gap-2 border-b-2 border-border px-3 py-3 text-sm font-bold uppercase tracking-wide transition-colors ${
                currentSection === s.id
                  ? "bg-text text-canvas"
                  : "text-text-secondary hover:bg-surface-alt hover:text-text"
              }`}
            >
              <Icon size={16} class="shrink-0" />
              <span>{s.label}</span>
            </a>
          );
        })
      }
    </div>
    <div class="mt-auto space-y-2 pt-6">
      <a
        href={withBase("/practice")}
        class="flex items-center gap-2 border-2 border-border bg-pale-yellow-bg px-3 py-3 text-sm font-bold uppercase tracking-wide text-pale-yellow-text transition-colors hover:bg-pale-yellow-bg-hover hover:text-pale-yellow-text-hover"
      >
        <Barbell size={16} weight="bold" class="shrink-0" />
        <span>Практикум</span>
      </a>
      <a
        href={withBase("/interview")}
        class="flex items-center gap-2 border-2 border-accent bg-pale-green-bg px-3 py-3 text-sm font-bold uppercase tracking-wide text-pale-green-text transition-colors hover:bg-pale-green-bg-hover hover:text-pale-green-text-hover"
      >
        <Microphone size={16} weight="bold" class="shrink-0" />
        <span>Мок-интервью</span>
      </a>
    </div>
  </nav>
</div>

<div
  id="mobile-drawer-overlay"
  class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
>
</div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const drawer = document.getElementById("mobile-drawer");
  const overlay = document.getElementById("mobile-drawer-overlay");
  const closeBtn = document.getElementById("mobile-drawer-close");

  function openDrawer() {
    drawer?.classList.remove("translate-x-full");
    drawer?.classList.add("translate-x-0");
    overlay?.classList.remove("opacity-0", "pointer-events-none");
    overlay?.classList.add("opacity-100");
    document.body.style.overflow = "hidden";
  }

  function closeDrawer() {
    drawer?.classList.add("translate-x-full");
    drawer?.classList.remove("translate-x-0");
    overlay?.classList.add("opacity-0", "pointer-events-none");
    overlay?.classList.remove("opacity-100");
    document.body.style.overflow = "";
  }

  btn?.addEventListener("click", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  overlay?.addEventListener("click", closeDrawer);

  // Любая ссылка в меню закрывает шторку (переход или переключение таба).
  drawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeDrawer);
  });
</script>
