---
import { List, MagnifyingGlass } from "@phosphor-icons/react";
import { withBase } from "../../lib/urls";
import HeaderNav from "./HeaderNav.astro";
import SearchInput from "./SearchInput.astro";
import { SearchModal } from "./SearchModal.tsx";
import { ThemeToggle } from "./ThemeToggle.tsx";
---

<header class="sticky top-0 z-50 border-b-[3px] border-border bg-canvas">
  <div class="mx-auto flex h-14 items-center justify-between gap-4 px-3">
    <div class="flex h-full items-center gap-4">
      <a
        href={withBase("/")}
        class="flex font-mono text-lg font-extrabold uppercase tracking-tight text-text transition-colors px-3 pt-0.5 pb-1.5 hover:text-accent"
      >
        <span class="text-text">PRE</span><span class="text-accent">PRA</span>
      </a>

      <HeaderNav />
    </div>

    <div class="flex items-center gap-2">
      <SearchInput />

      <ThemeToggle client:load />

      <button
        type="button"
        data-open-search
        class="sm:hidden flex items-center justify-center h-9 w-9 border-2 border-border text-text hover:bg-text hover:text-canvas transition-colors"
        aria-label="Поиск по сайту"
      >
        <MagnifyingGlass size={18} weight="bold" />
      </button>

      <button
        id="mobile-menu-btn"
        class="lg:hidden flex items-center justify-center h-9 w-9 border-2 border-border text-text hover:bg-text hover:text-canvas transition-colors"
        aria-label="Menu"
      >
        <List size={18} weight="bold" />
      </button>
    </div>
  </div>
</header>

<SearchModal client:load />