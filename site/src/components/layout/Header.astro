---
import { List } from "@phosphor-icons/react";
import { withBase } from "../../lib/urls";
import { ThemeToggle } from "./ThemeToggle.tsx";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;

const sections = [
  { id: "javascript", label: "JavaScript" },
  { id: "typescript", label: "TypeScript" },
  { id: "react", label: "React" },
  { id: "nextjs", label: "Next.js" },
  { id: "testing", label: "Тестирование" },
  { id: "html-css", label: "HTML и CSS" },
];
---

<header
  class="sticky top-0 z-50 border-b border-border bg-canvas/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-14 items-center justify-between px-3">
    <div class="flex items-center gap-6">
      <a
        href={withBase("/")}
        class="flex font-serif text-lg tracking-tight text-text hover:text-accent transition-colors font-medium px-3 pt-0.5 pb-1.5 rounded bg-surface hover:bg-surface-alt"
      >
        <span class="text-text">pre</span><span class="text-pale-green-text"
          >pra</span
        >.
      </a>
    </div>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex items-center justify-center h-8 w-8 rounded-[5px] text-text-secondary hover:text-accent hover:bg-surface-alt transition-colors"
        aria-label="Menu"
      >
        <List size={18} weight="bold" />
      </button>
    </div>
  </div>
</header>
