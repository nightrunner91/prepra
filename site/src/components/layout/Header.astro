---
import { List, MagnifyingGlass } from "@phosphor-icons/react";
import { withBase } from "../../lib/urls";
import HeaderNav from "./HeaderNav.astro";
import SearchInput from "./SearchInput.astro";
import { SearchModal } from "./SearchModal.tsx";
import { ThemeToggle } from "./ThemeToggle.tsx";
---

<header class="sticky top-0 z-50 border-b-[3px] border-border bg-canvas">
  <div
    class="mx-auto flex h-[var(--header-h)] items-center justify-between gap-4 px-4 lg:grid lg:grid-cols-[1fr_auto_1fr]"
  >
    <a
      href={withBase("/")}
      class="justify-self-start font-mono text-2xl font-extrabold uppercase tracking-tight text-text transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-strong"
    >
      <span class="text-text">PRE</span><span
        class="-mr-1 bg-accent px-1 text-accent-ink">PRA</span
      >
    </a>

    <HeaderNav />

    <div class="flex items-center justify-end gap-2">
      <SearchInput />

      <ThemeToggle client:load />

      <button
        type="button"
        data-open-search
        class="sm:hidden flex items-center justify-center h-9 w-9 border-2 border-border text-text hover:bg-text hover:text-canvas transition-colors active:translate-y-px"
        aria-label="Поиск по сайту"
      >
        <MagnifyingGlass size={18} weight="bold" />
      </button>

      <button
        id="mobile-menu-btn"
        class="lg:hidden flex items-center justify-center h-9 w-9 border-2 border-border text-text hover:bg-text hover:text-canvas transition-colors active:translate-y-px"
        aria-label="Menu"
      >
        <List size={18} weight="bold" />
      </button>
    </div>
  </div>
</header>

<SearchModal client:load />
