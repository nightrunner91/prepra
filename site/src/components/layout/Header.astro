---
import { List } from "@phosphor-icons/react";
import { withBase } from "../../lib/urls";
import { ThemeToggle } from "./ThemeToggle.tsx";
import SearchInput from "./SearchInput.astro";
import UserAccount from "./UserAccount.astro";

interface Props {
  currentSection?: string;
}

const { currentSection } = Astro.props;

const sections = [
  { id: "javascript", label: "JavaScript" },
  { id: "typescript", label: "TypeScript" },
  { id: "react", label: "React" },
  { id: "nextjs", label: "Next.js" },
  { id: "testing", label: "Тестирование" },
  { id: "html-css", label: "HTML и CSS" },
];
---

<header class="sticky top-0 z-50 border-b-[3px] border-border bg-canvas">
  <div class="mx-auto flex h-14 items-center justify-between px-3">
    <div class="flex items-center gap-6">
      <a
        href={withBase("/")}
        class="flex font-mono text-lg font-extrabold uppercase tracking-tight text-text transition-colors px-3 pt-0.5 pb-1.5 hover:text-accent"
      >
        <span class="text-text">PRE</span><span class="text-accent">PRA</span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <SearchInput />

      <ThemeToggle client:load />

      <UserAccount />

      <button
        id="mobile-menu-btn"
        class="lg:hidden flex items-center justify-center h-9 w-9 border-2 border-border text-text hover:bg-text hover:text-canvas transition-colors"
        aria-label="Menu"
      >
        <List size={18} weight="bold" />
      </button>
    </div>
  </div>
</header>
