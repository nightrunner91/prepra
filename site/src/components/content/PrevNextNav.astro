---
interface Props {
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
  sectionLabel: string;
  sectionHref: string;
}

const { prev, next, sectionLabel, sectionHref } = Astro.props;
---

<nav class="mt-12 border-t border-border pt-8">
  <div class="flex items-center justify-between gap-4">
    {prev ? (
      <a href={prev.href} class="group flex flex-col gap-1 text-left">
        <span class="font-mono text-[11px] uppercase tracking-wider text-text-tertiary">Предыдущая</span>
        <span class="text-sm text-text-secondary group-hover:text-text transition-colors">{prev.title}</span>
      </a>
    ) : (
      <a href={sectionHref} class="group flex flex-col gap-1 text-left">
        <span class="font-mono text-[11px] uppercase tracking-wider text-text-tertiary">Раздел</span>
        <span class="text-sm text-text-secondary group-hover:text-text transition-colors">{sectionLabel}</span>
      </a>
    )}

    {next && (
      <a href={next.href} class="group flex flex-col gap-1 text-right">
        <span class="font-mono text-[11px] uppercase tracking-wider text-text-tertiary">Следующая</span>
        <span class="text-sm text-text-secondary group-hover:text-text transition-colors">{next.title}</span>
      </a>
    )}
  </div>
</nav>
