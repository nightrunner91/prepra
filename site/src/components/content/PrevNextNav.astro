---
interface Props {
  prev?: { title: string; href: string } | null;
  next?: { title: string; href: string } | null;
  sectionLabel: string;
  sectionHref: string;
}

const { prev, next, sectionLabel, sectionHref } = Astro.props;
---

<nav class="mt-12 border-t-[3px] border-border pt-8">
  <div class="flex items-center justify-between gap-4">
    {
      prev ? (
        <a href={prev.href} class="group flex flex-col gap-1 text-left border-2 border-border p-4 hover:bg-text hover:text-canvas transition-all">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-text-tertiary group-hover:text-canvas/70">
            Предыдущая
          </span>
          <span class="text-sm font-bold text-text-secondary group-hover:text-canvas">
            {prev.title}
          </span>
        </a>
      ) : (
        <a href={sectionHref} class="group flex flex-col gap-1 text-left border-2 border-border p-4 hover:bg-text hover:text-canvas transition-all">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-text-tertiary group-hover:text-canvas/70">
            Раздел
          </span>
          <span class="text-sm font-bold text-text-secondary group-hover:text-canvas">
            {sectionLabel}
          </span>
        </a>
      )
    }

    {
      next && (
        <a href={next.href} class="group flex flex-col gap-1 text-right border-2 border-border p-4 hover:bg-text hover:text-canvas transition-all">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-text-tertiary group-hover:text-canvas/70">
            Следующая
          </span>
          <span class="text-sm font-bold text-text-secondary group-hover:text-canvas">
            {next.title}
          </span>
        </a>
      )
    }
  </div>
</nav>
