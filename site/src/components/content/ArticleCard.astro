---
import Badge from "../ui/Badge.astro";

interface Props {
  title: string;
  description?: string;
  href: string;
  order: number;
  tags?: string[];
  questionCount?: number;
}

const {
  title,
  description,
  href,
  order,
  tags = [],
  questionCount = 0,
} = Astro.props;
---

<a
  href={href}
  class="card-hover group block border-[3px] border-border bg-surface p-5 transition-all"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3
        class="font-mono text-base font-extrabold uppercase tracking-tight text-text leading-tight group-hover:text-accent transition-colors"
      >
        {title}
      </h3>
      {
        description && (
          <p class="mt-1.5 text-[13px] text-text-secondary line-clamp-2 leading-relaxed font-medium">
            {description}
          </p>
        )
      }
    </div>
    <span class="flex-shrink-0 font-mono text-sm font-bold text-text-tertiary border-2 border-border px-1.5 py-0.5 bg-surface-alt"
      >#{order}</span
    >
  </div>

  <div class="mt-3 flex items-center gap-3">
    {
      questionCount > 0 && (
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-text-tertiary border border-border px-1.5 py-0.5">
          {questionCount} вопросов
        </span>
      )
    }
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <Badge label={tag} size="xs" />
          ))}
          {tags.length > 3 && (
            <Badge label={`+${tags.length - 3}`} color="neutral" size="xs" />
          )}
        </div>
      )
    }
  </div>
</a>
