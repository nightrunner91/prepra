---
interface Props {
  totalArticles: number;
  totalQuestions: number;
  sectionsCount: number;
}

const { totalArticles, totalQuestions, sectionsCount } = Astro.props;
---

<div class="mt-16 lg:mt-20">
  <div class="animate-fade-in border-[3px] border-border bg-pale-green-bg p-6">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <h2
          class="font-mono text-2xl font-extrabold uppercase tracking-tight text-text sm:text-3xl"
        >
          Твой прогресс
        </h2>
        <p class="mt-2 text-sm text-text-secondary font-bold">
          Отслеживай подготовку и двигайся к цели.
        </p>
      </div>
      <div
        class="flex items-center gap-6 font-mono text-sm font-bold uppercase tracking-wider"
      >
        <div class="text-center">
          <div class="text-2xl text-accent">{totalArticles}</div>
          <div class="text-[10px] text-text-tertiary">Статей</div>
        </div>
        <div class="h-8 w-[2px] bg-border"></div>
        <div class="text-center">
          <div class="text-2xl text-accent">{totalQuestions}</div>
          <div class="text-[10px] text-text-tertiary">Вопросов</div>
        </div>
        <div class="h-8 w-[2px] bg-border"></div>
        <div class="text-center">
          <div class="text-2xl text-accent">{sectionsCount}</div>
          <div class="text-[10px] text-text-tertiary">Разделов</div>
        </div>
      </div>
    </div>
    <div class="mt-6">
      <div class="flex items-center gap-3">
        <div
          class="h-2 flex-1 border-2 border-border bg-surface overflow-hidden"
        >
          <div
            id="progress-bar-fill"
            class="h-full bg-accent transition-all duration-300"
            style="width: 0%"
          >
          </div>
        </div>
        <span
          id="progress-bar-label"
          class="font-mono text-sm font-bold text-text-tertiary tabular-nums"
        >
          0%
        </span>
      </div>
      <p class="mt-2 text-sm font-mono text-text-tertiary">
        Отмечай статьи как изученные — прогресс обновляется автоматически.
      </p>
    </div>
  </div>
</div>

<script define:vars={{ totalQuestions }}>
  function countAnsweredQuestions() {
    let count = 0;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith("prepra:quiz:")) {
          const data = JSON.parse(localStorage.getItem(key) || "{}");
          if (data.lastAttempt && data.lastAttempt.answers) {
            count += Object.keys(data.lastAttempt.answers).length;
          }
        }
      }
    } catch (e) {
      // ignore
    }
    return count;
  }

  function updateProgress() {
    const answered = countAnsweredQuestions();
    const max = totalQuestions || 1;
    const pct = Math.min(100, Math.round((answered / max) * 100));
    const fill = document.getElementById("progress-bar-fill");
    const label = document.getElementById("progress-bar-label");
    if (fill) fill.style.width = pct + "%";
    if (label) label.textContent = pct + "%";
  }

  updateProgress();
  window.addEventListener("quiz:update", updateProgress);
  window.addEventListener("read:update", updateProgress);
  window.addEventListener("storage", updateProgress);
</script>
