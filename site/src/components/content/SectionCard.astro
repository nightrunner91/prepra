---
import type { Icon } from "@phosphor-icons/react";

interface Props {
  title: string;
  description: string;
  href: string;
  articleCount: number;
  questionCount: number;
  color?: "red" | "blue" | "green" | "yellow";
  icon?: Icon;
}

const {
  title,
  description,
  href,
  articleCount,
  questionCount,
  color = "blue",
  icon: Icon,
} = Astro.props;
---

<a
  href={href}
  class="card-hover group flex h-full flex-col rounded-[8px] border border-border bg-surface p-6 transition-colors"
>
  <div class="flex items-start justify-between">
    <h3
      class="font-serif text-xl text-text leading-snug group-hover:text-accent transition-colors"
    >
      {title}
    </h3>
    {
      Icon && (
        <span
          class={`shrink-0 mt-1 opacity-75 ${
            color === "red"
              ? "text-pale-red-text"
              : color === "green"
                ? "text-pale-green-text"
                : color === "yellow"
                  ? "text-pale-yellow-text"
                  : "text-pale-blue-text"
          }`}
        >
          <Icon size={20} />
        </span>
      )
    }
  </div>

  <p class="mt-2 text-sm text-text-secondary leading-relaxed pe-20">
    {description}
  </p>

  <div
    class="mt-auto pt-4 flex items-center gap-4 font-mono text-xs text-text-tertiary"
  >
    <span>{articleCount} статей</span>
    <span class="text-border">/</span>
    <span>{questionCount} вопросов</span>
  </div>
</a>
