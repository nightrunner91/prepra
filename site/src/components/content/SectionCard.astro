---
import type { Icon } from "@phosphor-icons/react";

interface Props {
  title: string;
  description: string;
  href: string;
  articleCount: number;
  questionCount: number;
  color?: "red" | "blue" | "green" | "yellow";
  icon?: Icon;
}

const {
  title,
  description,
  href,
  articleCount,
  questionCount,
  color = "blue",
  icon: Icon,
} = Astro.props;
---

<a
  href={href}
  class="card-hover group flex h-full flex-col border-[3px] border-border bg-surface p-6 transition-all"
>
  <div class="flex items-start justify-between">
    <h3
      class="font-mono text-xl font-extrabold uppercase tracking-tight text-text leading-tight group-hover:text-accent transition-colors"
    >
      {title}
    </h3>
    {
      Icon && (
        <span
          class={`shrink-0 border-2 border-border p-1 ${
            color === "red"
              ? "bg-pale-red-bg text-pale-red-text"
              : color === "green"
                ? "bg-pale-green-bg text-pale-green-text"
                : color === "yellow"
                  ? "bg-pale-yellow-bg text-pale-yellow-text"
                  : "bg-pale-blue-bg text-pale-blue-text"
          }`}
        >
          <Icon size={20} weight="bold" />
        </span>
      )
    }
  </div>

  <p
    class="mt-3 text-sm text-text-secondary leading-relaxed font-medium lg:pe-16"
  >
    {description}
  </p>

  <div
    class="mt-auto pt-4 flex items-center gap-3 font-mono text-xs font-bold uppercase tracking-wider text-text-tertiary"
  >
    <span class="border border-border px-1.5 py-0.5">{articleCount} статей</span
    >
    <span class="border border-border px-1.5 py-0.5"
      >{questionCount} вопросов</span
    >
  </div>
</a>
