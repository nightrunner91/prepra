---
import type { Icon } from "@dev.icons/react";
import type { SectionMark } from "../../lib/section-marks";
import { SECTION_MARK_CLASSES } from "../../lib/section-marks";

interface Props {
  title: string;
  description: string;
  href: string;
  articleCount: number;
  questionCount: number;
  color?: SectionMark;
  icon?: Icon;
}

const {
  title,
  description,
  href,
  articleCount,
  questionCount,
  color = "neutral",
  icon: Icon,
} = Astro.props;
---

<a
  href={href}
  class="tile card-hover group"
>
  <div class="flex items-start justify-between">
    <h3
      class="font-mono text-2xl font-extrabold uppercase tracking-tight text-text leading-tight group-hover:text-accent-strong transition-colors"
    >
      {title}
    </h3>
    {
      Icon && (
        <span
          class={`mark-hover shrink-0 border-2 border-border p-1 ${SECTION_MARK_CLASSES[color]}`}
        >
          <Icon size={20} weight="bold" />
        </span>
      )
    }
  </div>

  <p
    class="mt-3 text-sm text-text-secondary leading-relaxed font-medium lg:pe-16"
  >
    {description}
  </p>

  <div
    class="mt-auto pt-4 flex flex-wrap items-center gap-2 eyebrow text-text-tertiary"
  >
    <span class="border border-border px-1.5 py-0.5">{articleCount} статей</span
    >
    <span class="border border-border px-1.5 py-0.5"
      >{questionCount} вопросов</span
    >
  </div>
</a>
