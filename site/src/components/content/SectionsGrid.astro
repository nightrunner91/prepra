---
import type { Icon } from "@dev.icons/react";
import { withBase } from "../../lib/urls";
import SectionCard from "./SectionCard.astro";

interface SectionItem {
  id: string;
  label: string;
  icon?: Icon;
  description: string;
  color: "red" | "blue" | "green" | "yellow" | "neutral";
  articleCount: number;
  questionCount: number;
}

interface Props {
  sections: SectionItem[];
}

const { sections } = Astro.props;
---

<div id="sections">
  <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      sections.map((s, i) => (
        <div class="animate-fade-in" style={`transition-delay: ${i * 40}ms`}>
          <SectionCard
            title={s.label}
            description={s.description}
            href={withBase(`/${s.id}`)}
            articleCount={s.articleCount}
            questionCount={s.questionCount}
            color={s.color}
            icon={s.icon}
          />
        </div>
      ))
    }
  </div>
</div>
