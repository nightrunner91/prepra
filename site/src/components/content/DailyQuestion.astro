---
import { ArrowRight, QuestionMark } from "@phosphor-icons/react";
import { withBase } from "../../lib/urls";

interface Props {
  question: {
    text: string;
    answer: string | null;
    sectionId: string;
    sectionLabel: string;
    articleSlug: string;
  };
  questionCount: number;
}

const { question, questionCount } = Astro.props;

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

/** Минимальный inline-набор из статей: `код`. */
function renderInline(text: string): string {
  return escapeHtml(text).replace(/`([^`]+)`/g, "<code>$1</code>");
}
---

<section class="mt-16 lg:mt-20">
  <div class="panel-wash border-[3px] border-border">
    <div class="grid lg:grid-cols-[300px_minmax(0,1fr)]">
      <div
        class="border-b-[3px] border-border bg-canvas p-6 lg:border-b-0 lg:border-r-[3px]"
      >
        <QuestionMark
          size={28}
          weight="bold"
          className="text-accent-strong"
          aria-hidden="true"
        />
        <h2
          class="mt-4 font-mono text-2xl font-extrabold uppercase tracking-tight text-text"
        >
          Вопрос дня
        </h2>
        <p
          class="mt-2 text-base font-medium leading-relaxed text-text-secondary"
        >
          Один в день — чтобы тема не выветривалась перед интервью.
        </p>
        <a
          href={withBase(`/${question.sectionId}`)}
          class="mt-5 inline-block border-2 border-border bg-surface px-2 py-1 eyebrow text-text transition-colors hover:bg-text hover:text-canvas focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text"
        >
          {question.sectionLabel}
        </a>
      </div>

      <div class="flex flex-col p-6 lg:p-8">
        <p
          id="daily-question-text"
          class="text-lg font-bold leading-relaxed text-text sm:text-xl"
          set:html={renderInline(question.text)}
        >
        </p>
        {
          question.answer && (
            <details class="group mt-6">
              <summary class="inline-flex w-fit cursor-pointer list-none items-center gap-2 border-b-2 border-border eyebrow text-text transition-colors hover:border-accent-strong hover:text-accent-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text">
                <span class="group-open:hidden">Показать ответ</span>
                <span class="hidden group-open:inline">Скрыть ответ</span>
              </summary>
              <p
                class="mt-4 text-base leading-relaxed text-text-secondary"
                set:html={renderInline(question.answer)}
              >
              </p>
            </details>
          )
        }
        <a
          id="daily-question-link"
          href={withBase(`/${question.sectionId}/${question.articleSlug}`)}
          class="group mt-auto inline-flex w-fit items-center gap-2 border-b-2 border-border pt-6 eyebrow text-text transition-colors hover:border-accent-strong hover:text-accent-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text"
        >
          Читать статью
          <ArrowRight
            size={14}
            weight="bold"
            className="transition-transform group-hover:translate-x-1"
          />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
