---
import {
  ArrowRight,
  Barbell,
  BookOpen,
  Check,
  Microphone,
} from "@phosphor-icons/react";
import { plural } from "../../lib/plural";
import { withBase } from "../../lib/urls";

interface Props {
  articleCount: number;
  taskCount: number;
  presetCount: number;
}

const { articleCount, taskCount, presetCount } = Astro.props;

const cardClass =
  "card-hover group flex flex-col border-[3px] border-border p-6 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text lg:p-8";
const linkClass =
  "mt-auto inline-flex w-fit items-center gap-2 border-b-2 border-current pt-6 eyebrow transition-colors";
const badgeClass =
  "inline-flex w-fit items-center gap-2 border-2 border-border bg-surface px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-[0.16em] text-text";
/* Счётчик и бейдж — одна строка: метрика слева, бейдж справа. */
const headClass = "flex flex-wrap items-center justify-between gap-x-4 gap-y-2";
const titleClass =
  "mt-5 font-mono text-2xl font-extrabold uppercase tracking-tight";
---

<section id="product" class="mt-16 scroll-mt-24 lg:mt-20">
  <div class="border-b-[3px] border-border pb-5">
    <h2
      class="font-mono text-3xl font-extrabold uppercase tracking-tight text-text sm:text-4xl lg:text-5xl"
    >
      Форматы подготовки
    </h2>
    <p
      class="mt-3 text-base font-medium leading-relaxed text-text-secondary sm:text-lg"
    >
      Читай разборы, решай задачи и тренируй ответы вслух — три формата под
      разные этапы подготовки.
    </p>
  </div>

  <div class="mt-8 grid gap-10 lg:grid-cols-12">
    <a
      href={withBase("/theory")}
      class={`${cardClass} fill-theory lg:col-span-6`}
    >
      <div class={headClass}>
        <div class="flex items-baseline gap-2">
          <span
            class="font-mono text-5xl font-extrabold leading-none tabular-nums xl:text-6xl"
            >{articleCount}</span
          >
          <span class="font-mono text-xs font-bold uppercase tracking-widest"
            >{plural(articleCount, "статья", "статьи", "статей")}</span
          >
        </div>
        <span class={badgeClass}>
          <BookOpen size={16} weight="bold" />
          Читай
        </span>
      </div>

      <h3 class={titleClass}>Теория</h3>
      <p class="mt-2 font-mono text-xs font-bold uppercase tracking-[0.12em]">
        Что внутри
      </p>
      <ul class="mt-3 grid max-w-[52ch] gap-2 text-sm font-medium sm:text-base">
        <li class="flex gap-2">
          <Check
            size={16}
            weight="bold"
            className="mt-1 shrink-0"
            aria-hidden="true"
          />
          Разбор с примерами кода и схемами
        </li>
        <li class="flex gap-2">
          <Check
            size={16}
            weight="bold"
            className="mt-1 shrink-0"
            aria-hidden="true"
          />
          Вопросы для самопроверки в конце статьи
        </li>
        <li class="flex gap-2">
          <Check
            size={16}
            weight="bold"
            className="mt-1 shrink-0"
            aria-hidden="true"
          />
          Шпаргалка раздела для повторения
        </li>
      </ul>

      <span class={linkClass}>
        Открыть теорию
        <ArrowRight
          size={14}
          weight="bold"
          className="transition-transform group-hover:translate-x-1"
        />
      </span>
    </a>

    <div
      class="grid gap-10 sm:grid-cols-2 lg:col-span-6 lg:grid-cols-1 lg:grid-rows-2"
    >
      <a href={withBase("/practice")} class={`${cardClass} fill-practice`}>
        <div class={headClass}>
          <div class="flex items-baseline gap-2">
            <span
              class="font-mono text-4xl font-extrabold leading-none tabular-nums"
              >{taskCount}</span
            >
            <span class="font-mono text-xs font-bold uppercase tracking-widest"
              >{plural(taskCount, "задача", "задачи", "задач")}</span
            >
          </div>
          <span class={badgeClass}>
            <Barbell size={16} weight="bold" />
            Решай
          </span>
        </div>

        <h3 class={titleClass}>Практика</h3>
        <p class="mt-2 text-sm font-medium leading-relaxed sm:text-base">
          Задачи по базовому JavaScript: выбор ответа, «что выведет код» и
          задачи с автотестами.
        </p>

        <span class={linkClass}>
          Открыть практику
          <ArrowRight
            size={14}
            weight="bold"
            className="transition-transform group-hover:translate-x-1"
          />
        </span>
      </a>

      <a href={withBase("/interview")} class={`${cardClass} fill-interview`}>
        <div class={headClass}>
          <div class="flex items-baseline gap-2">
            <span
              class="font-mono text-4xl font-extrabold leading-none tabular-nums"
              >{presetCount}</span
            >
            <span class="font-mono text-xs font-bold uppercase tracking-widest"
              >{plural(presetCount, "сет", "сета", "сетов")}</span
            >
          </div>
          <span class={badgeClass}>
            <Microphone size={16} weight="bold" />
            Отвечай
          </span>
        </div>

        <h3 class={titleClass}>Интервью</h3>
        <p class="mt-2 text-sm font-medium leading-relaxed sm:text-base">
          Вопросы из разных разделов, ответы вслух, самопроверка и карта слабых
          тем с переходом к статье.
        </p>

        <span class={linkClass}>
          Пройти интервью
          <ArrowRight
            size={14}
            weight="bold"
            className="transition-transform group-hover:translate-x-1"
          />
        </span>
      </a>
    </div>
  </div>
</section>
