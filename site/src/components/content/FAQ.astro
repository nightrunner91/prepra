---
import { CaretDown } from "@phosphor-icons/react";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="mx-auto max-w-4xl">
  <h2
    class="font-mono text-3xl text-text sm:text-5xl leading-tight tracking-tight font-extrabold uppercase"
  >
    Вопросы и ответы
  </h2>
  <p class="mt-2 font-bold text-sm uppercase tracking-wide text-text-secondary">
    Всё что нужно знать о prepra.
  </p>
  <div class="mt-8 border-t-[3px] border-border" data-faq>
    {
      items.map((item, i) => (
        <div class="faq-item border-b-[3px] border-border" data-faq-item>
          <button
            type="button"
            class="faq-trigger flex w-full cursor-pointer items-center justify-between py-4 text-left font-mono text-base font-bold uppercase tracking-tight text-text transition-colors hover:text-accent"
            aria-expanded="false"
            aria-controls={`faq-panel-${i}`}
            id={`faq-btn-${i}`}
          >
            <span>{item.question}</span>
            <CaretDown
              size={24}
              weight="bold"
              className="faq-chevron ml-4 shrink-0 transition-transform duration-200"
            />
          </button>
          <div
            class="faq-panel grid transition-[grid-template-rows] duration-200 ease-out"
            style="grid-template-rows: 0fr"
            id={`faq-panel-${i}`}
            role="region"
            aria-labelledby={`faq-btn-${i}`}
          >
            <div class="overflow-hidden">
              <div class="pb-6 text text-text-secondary leading-relaxed">
                <Fragment set:html={item.answer} />
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .faq-trigger[aria-expanded="true"] :global(.faq-chevron) {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((faq) => {
    const items = faq.querySelectorAll<HTMLElement>("[data-faq-item]");

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger")!;
      const panel = item.querySelector<HTMLDivElement>(".faq-panel")!;

      trigger.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";

        items.forEach((other) => {
          const otherTrigger =
            other.querySelector<HTMLButtonElement>(".faq-trigger")!;
          const otherPanel = other.querySelector<HTMLDivElement>(".faq-panel")!;
          if (otherTrigger !== trigger) {
            otherTrigger.setAttribute("aria-expanded", "false");
            otherPanel.style.gridTemplateRows = "0fr";
          }
        });

        trigger.setAttribute("aria-expanded", String(!isOpen));
        panel.style.gridTemplateRows = isOpen ? "0fr" : "1fr";
      });
    });
  });
</script>
