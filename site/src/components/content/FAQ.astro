---
import { CaretDown } from "@phosphor-icons/react";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="mt-16 lg:mt-32">
  <div
    class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:gap-14"
  >
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2
        class="font-mono text-3xl font-extrabold uppercase leading-tight tracking-tight text-text sm:text-4xl lg:text-5xl"
      >
        Частые вопросы
      </h2>
      <p
        class="mt-3 text-base font-medium leading-relaxed text-text-secondary sm:text-lg"
      >
        Всё что нужно знать о prepra.
      </p>
    </div>

    <div class="border-t-[3px] border-border" data-faq>
      {
        items.map((item, i) => (
          <div class="border-b-[3px] border-border" data-faq-item>
            <button
              type="button"
              class="faq-trigger flex w-full cursor-pointer items-start justify-between gap-4 py-5 text-left font-mono text-base font-bold leading-relaxed text-text transition-colors hover:text-accent-strong sm:text-lg"
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-panel-${i}`}
              id={`faq-btn-${i}`}
            >
              <span>{item.question}</span>
              <CaretDown
                size={20}
                weight="bold"
                className="faq-chevron mt-0.5 shrink-0 transition-transform duration-200"
              />
            </button>
            <div
              class="faq-panel grid transition-[grid-template-rows] duration-200 ease-out"
              style={
                i === 0 ? "grid-template-rows: 1fr" : "grid-template-rows: 0fr"
              }
              id={`faq-panel-${i}`}
              role="region"
              aria-labelledby={`faq-btn-${i}`}
            >
              <div class="faq-panel-inner overflow-hidden">
                <div class="pb-6 pr-2 text-base leading-relaxed text-text-secondary">
                  <Fragment set:html={item.answer} />
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-trigger[aria-expanded="true"] :global(.faq-chevron) {
    transform: rotate(180deg);
  }

  .faq-panel :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-strong);
    text-underline-offset: 3px;
  }

  .faq-panel :global(a:hover) {
    color: var(--color-text-secondary);
  }

  .faq-panel-inner {
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .faq-trigger[aria-expanded="false"] + .faq-panel .faq-panel-inner {
    opacity: 0;
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel-inner {
      transition: opacity 160ms linear;
    }

    .faq-trigger[aria-expanded="false"] + .faq-panel .faq-panel-inner {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((faq) => {
    const items = faq.querySelectorAll<HTMLElement>("[data-faq-item]");

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger")!;
      const panel = item.querySelector<HTMLDivElement>(".faq-panel")!;

      trigger.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";

        items.forEach((other) => {
          const otherTrigger =
            other.querySelector<HTMLButtonElement>(".faq-trigger")!;
          const otherPanel = other.querySelector<HTMLDivElement>(".faq-panel")!;
          if (otherTrigger !== trigger) {
            otherTrigger.setAttribute("aria-expanded", "false");
            otherPanel.style.gridTemplateRows = "0fr";
          }
        });

        trigger.setAttribute("aria-expanded", String(!isOpen));
        panel.style.gridTemplateRows = isOpen ? "0fr" : "1fr";
      });
    });
  });
</script>
