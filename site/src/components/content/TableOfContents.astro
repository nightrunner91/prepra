---
interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

{
  h2s.length > 0 && (
    <aside class="fixed top-14 right-0 w-56 h-[calc(100vh-3.5rem)] overflow-y-auto py-6 px-3 bg-canvas">
      <h4 class="mb-3 font-mono text-xs font-bold uppercase tracking-widest text-text-tertiary border-b-2 border-border pb-2">
        Якоря
      </h4>
      <ul class="space-y-0 border-l-[3px] border-border">
        {h2s.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="block border-l-[3px] -ml-[3px] py-1.5 pl-3 text-[13px] font-bold uppercase tracking-wide text-text-secondary hover:text-accent hover:border-accent transition-colors border-transparent"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
