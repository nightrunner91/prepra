---
interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

{h2s.length > 0 && (
  <aside class="hidden xl:block w-52 flex-shrink-0">
    <nav class="sticky top-20">
      <h4 class="mb-3 font-mono text-[11px] uppercase tracking-wider text-text-tertiary">
        Содержание
      </h4>
      <ul class="space-y-1.5 border-l border-border">
        {h2s.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="block border-l -ml-px py-1 pl-3 text-[13px] text-text-secondary hover:text-text transition-colors border-transparent hover:border-accent"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}
