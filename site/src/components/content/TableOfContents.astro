---
interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

{h2s.length > 0 && (
  <aside class="fixed top-14 right-0 w-56 h-[calc(100vh-3.5rem)] overflow-y-auto py-6 px-3">
    <h4 class="mb-3 font-mono text-[11px] uppercase tracking-wider text-text-tertiary">
      Содержание
    </h4>
    <ul class="space-y-1.5 border-l border-border">
      {h2s.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class="block border-l -ml-px py-1 pl-3 text-[13px] text-text-secondary hover:text-accent transition-colors border-transparent hover:border-accent"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
