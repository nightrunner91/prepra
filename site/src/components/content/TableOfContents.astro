---
interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

{
  h2s.length > 0 && (
    <aside class="fixed bottom-0 right-0 top-[var(--header-offset)] w-56 overflow-y-auto bg-canvas px-3 py-6">
      <h4 class="mb-3 font-mono text-xs font-bold uppercase tracking-widest text-text-tertiary border-b-2 border-border pb-2">
        Якоря
      </h4>
      <ul class="space-y-0 border-l-[3px] border-border">
        {h2s.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="block border-l-[3px] -ml-[3px] py-1.5 pl-3 text-xs font-bold uppercase tracking-wide text-text-secondary hover:text-accent hover:border-accent transition-colors border-transparent"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
