---
import { ArrowRight } from "@phosphor-icons/react";
import { withBase } from "../../lib/urls";
---

<section class="mt-16 border-t-[3px] border-border bg-invert-bg lg:mt-24">
  <div
    class="mx-auto flex max-w-[1600px] flex-col gap-8 px-6 py-20 lg:flex-row lg:items-end lg:justify-between lg:px-12 lg:py-36"
  >
    <div class="max-w-2xl">
      <p class="eyebrow text-invert-accent">Бесплатно и без регистрации</p>
      <h2
        class="mt-3 font-mono text-3xl font-extrabold uppercase tracking-tight text-invert-text sm:text-4xl lg:text-5xl"
      >
        Пора проверить себя
      </h2>
      <p
        class="mt-3 text-base font-medium leading-relaxed text-invert-text sm:text-lg"
      >
        Начни с базы или сразу пройди интервью и посмотри, где просядешь.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={withBase("/javascript")} class="btn btn-lg btn-primary group">
        Начать с JavaScript
        <ArrowRight
          size={16}
          weight="bold"
          className="transition-transform group-hover:translate-x-1"
        />
      </a>
      <a href={withBase("/interview")} class="btn btn-lg btn-secondary group">
        Пройти интервью
        <ArrowRight
          size={16}
          weight="bold"
          className="transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>
