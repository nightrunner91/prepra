---
const steps = [
  {
    title: "Разбери теорию",
    text: "Разбор с примерами кода и схемами: не заучивание, а понимание.",
  },
  {
    title: "Закрепи в практике",
    text: "Задачи по JavaScript трёх уровней и автотесты в браузере.",
  },
  {
    title: "Пройди интервью",
    text: "Сет вопросов из разных разделов: отвечаешь вслух и сам оцениваешь каждый ответ.",
  },
  {
    title: "Пойми слабую тему",
    text: "Результат интервью показывает просевший раздел и ведёт обратно в статью.",
  },
];
---

<section
  class="mt-16 bg-surface lg:mt-24 border-t-[3px] border-b-[3px] border-border"
>
  <div class="mx-auto max-w-[1600px] px-6 py-12 lg:px-12 lg:py-28">
    <div class="border-b-[3px] border-border pb-5">
      <h2
        class="font-mono text-3xl font-extrabold uppercase tracking-tight text-text sm:text-4xl lg:text-5xl"
      >
        Цикл подготовки
      </h2>
      <p
        class="mt-3 text-base font-medium leading-relaxed text-text-secondary sm:text-lg"
      >
        Четыре шага, которые повторяются для каждой темы — от разбора статьи до
        закрытой слабой темы.
      </p>
    </div>

    <div class="grid gap-8 pt-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        steps.map((step, index) => (
          <div>
            <div class="flex items-baseline gap-1 font-mono leading-none">
              <span class="text-4xl font-extrabold tabular-nums text-accent-strong">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span
                class="text-xl font-extrabold text-text-tertiary"
                aria-hidden="true"
              >
                /
              </span>
            </div>
            <h3 class="mt-3 font-mono text-lg font-extrabold uppercase tracking-tight text-text ps-6">
              {step.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base pe-8 ps-6">
              {step.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
