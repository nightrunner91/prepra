---
const steps = [
  {
    title: "Выбери раздел",
    text: "Начни с JavaScript или открой тему, которая проседает на работе.",
  },
  {
    title: "Прочитай статью",
    text: "Разбор с примерами кода, схемами и внутренними механизмами.",
  },
  {
    title: "Ответь на вопросы",
    text: "Самопроверка в конце статьи: вслух, без подглядывания.",
  },
  {
    title: "Закрепи в практике",
    text: "Задачи и мок-интервью покажут, что осталось повторить.",
  },
];
---

<section class="mt-24 lg:mt-32">
  <div class="border-b-[3px] border-border pb-5">
    <h2
      class="font-mono text-3xl font-extrabold uppercase tracking-tight text-text sm:text-4xl lg:text-5xl"
    >
      Как проходит подготовка
    </h2>
    <p
      class="mt-3 text-base font-medium leading-relaxed text-text-secondary sm:text-lg lg:whitespace-nowrap"
    >
      Замкнутый цикл: прочитал, ответил, решил, вернулся к теме.
    </p>
  </div>

  <div class="grid gap-8 pt-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {
      steps.map((step, index) => (
        <div>
          <span class="font-mono text-4xl font-extrabold leading-none tabular-nums text-accent">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 font-mono text-lg font-extrabold uppercase tracking-tight text-text">
            {step.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base">
            {step.text}
          </p>
        </div>
      ))
    }
  </div>
</section>
