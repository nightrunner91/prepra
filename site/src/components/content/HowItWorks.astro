---
const steps = [
  {
    title: "Выбери тему",
    text: "Начни с JavaScript или возьми раздел, который проседает на работе.",
  },
  {
    title: "Разбери статью",
    text: "Механизмы, примеры кода и схемы — не заучивание, а понимание.",
  },
  {
    title: "Ответь вслух",
    text: "Вопросы для самопроверки в конце статьи: без подглядывания, своими словами.",
  },
  {
    title: "Вернись к теме",
    text: "Шпаргалка раздела и вопрос дня возвращают пройденное в память перед интервью.",
  },
];
---

<section class="mt-24 lg:mt-32">
  <div class="border-b-[3px] border-border pb-5">
    <h2
      class="font-mono text-3xl font-extrabold uppercase tracking-tight text-text sm:text-4xl lg:text-5xl"
    >
      Методика: от статьи до уверенного ответа
    </h2>
    <p
      class="mt-3 text-base font-medium leading-relaxed text-text-secondary sm:text-lg"
    >
      Четыре шага, которые повторяются для каждой темы — от первого разбора до
      повторения перед интервью.
    </p>
  </div>

  <div class="grid gap-8 pt-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {
      steps.map((step, index) => (
        <div>
          <span class="font-mono text-4xl font-extrabold leading-none tabular-nums text-accent-strong">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 font-mono text-lg font-extrabold uppercase tracking-tight text-text">
            {step.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary sm:text-base">
            {step.text}
          </p>
        </div>
      ))
    }
  </div>
</section>
