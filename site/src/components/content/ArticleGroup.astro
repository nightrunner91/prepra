---
import ArticleCard from "./ArticleCard.astro";

interface ArticleItem {
  article: any;
  href: string;
}

interface Subgroup {
  title: string;
  items: ArticleItem[];
}

interface Props {
  title: string;
  items: ArticleItem[];
  subgroups: Subgroup[];
}

const { title, items, subgroups } = Astro.props;
---

<section class="animate-fade-in">
  <h2
    class="font-mono text-2xl text-text leading-tight tracking-tight font-extrabold uppercase"
  >
    {title}
  </h2>

  {
    items.length > 0 && (
      <div class="mt-4 space-y-3">
        {items.map(({ article, href }) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={href}
            tags={article.data.tags}
            questionCount={article.data.questions?.length || 0}
          />
        ))}
      </div>
    )
  }

  {
    subgroups.length > 0 && (
      <div class="mt-6 space-y-6">
        {subgroups.map((subgroup) => (
          <div>
            <h3 class="font-mono text-lg font-bold uppercase tracking-tight text-text-secondary border-l-[3px] border-accent pl-3">
              {subgroup.title}
            </h3>
            <div class="mt-3 space-y-3">
              {subgroup.items.map(({ article, href }) => (
                <ArticleCard
                  title={article.data.title}
                  description={article.data.description}
                  href={href}
                  tags={article.data.tags}
                  questionCount={article.data.questions?.length || 0}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    )
  }
</section>
