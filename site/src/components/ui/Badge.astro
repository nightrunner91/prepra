---
interface Props {
  label: string;
  color?: 'red' | 'blue' | 'green' | 'yellow' | 'neutral';
  size?: 'sm' | 'md';
}

const { label, color = 'neutral', size = 'sm' } = Astro.props;

const colorMap = {
  red: 'bg-pale-red-bg text-pale-red-text',
  blue: 'bg-pale-blue-bg text-pale-blue-text',
  green: 'bg-pale-green-bg text-pale-green-text',
  yellow: 'bg-pale-yellow-bg text-pale-yellow-text',
  neutral: 'bg-surface-alt text-text-secondary',
};

const sizeMap = {
  sm: 'px-2 py-0.5 text-[11px]',
  md: 'px-3 py-1 text-xs',
};
---

<span class={`inline-block rounded-full font-mono uppercase tracking-wider ${colorMap[color]} ${sizeMap[size]}`}>
  {label}
</span>
