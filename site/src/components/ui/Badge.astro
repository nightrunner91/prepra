---
interface Props {
  label: string;
  color?: "red" | "blue" | "green" | "yellow" | "neutral";
  size?: "xs" | "sm" | "md";
  searchTag?: string;
}

const { label, color = "neutral", size = "sm", searchTag } = Astro.props;

const colorMap = {
  red: "bg-pale-red-bg text-pale-red-text badge-hover-red",
  blue: "bg-pale-blue-bg text-pale-blue-text badge-hover-blue",
  green: "bg-pale-green-bg text-pale-green-text badge-hover-green",
  yellow: "bg-pale-yellow-bg text-pale-yellow-text badge-hover-yellow",
  neutral: "bg-surface-alt text-text-secondary badge-hover-neutral",
};

const sizeMap = {
  xs: "px-2 py-0.5 text-xs",
  sm: "px-2.5 py-1 text-sm",
  md: "px-3 py-1 text-md",
};

const classes = `inline-block border-2 border-border font-mono font-bold uppercase tracking-wider transition-all cursor-pointer ${colorMap[color]} ${sizeMap[size]}`;
---

{
  searchTag ? (
    <button
      type="button"
      data-search-tag={searchTag}
      aria-label={`Найти статьи по тегу «${searchTag}»`}
      class={classes}
    >
      {label}
    </button>
  ) : (
    <span class={classes}>
      {label}
    </span>
  )
}