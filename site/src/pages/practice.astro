---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PracticeApp } from "../components/practice/PracticeApp";
import { withBase } from "../lib/urls";
---

<BaseLayout
  title="Практикум"
  description="Бесплатный банк задач по JavaScript для подготовки к собеседованию: hoisting, замыкания, this, event loop, Map/Set, Big O, промисы. С разбором ответов и тестами в браузере."
>
  <div class="mx-auto max-w-[1500px] px-3 py-6 sm:px-6 lg:py-10">
    <nav class="mb-4 flex flex-wrap items-center gap-3 font-mono text-[10px] font-bold uppercase tracking-wider">
      <a href={withBase("/")} class="text-accent hover:underline">Главная</a>
      <span class="text-text-tertiary">/</span>
      <a href={withBase("/javascript")} class="text-accent hover:underline">JavaScript</a>
      <span class="text-text-tertiary">/</span>
      <span class="text-text-secondary">Практикум</span>
    </nav>
    <PracticeApp client:load />
  </div>
</BaseLayout>
