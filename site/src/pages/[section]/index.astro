---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import Sidebar from "../../components/layout/Sidebar.astro";
import ArticleGroup from "../../components/content/ArticleGroup.astro";
import { withBase } from "../../lib/urls";
import {
  normalizeSlug,
  parseSectionDescription,
  parseSectionReadme,
} from "../../lib/section-readme";

export async function getStaticPaths() {
  const sections = [
    {
      id: "javascript",
      label: "JavaScript",
      description:
        "Основы JavaScript, ES6+, замыкания, прототипы, асинхронность и многое другое",
    },
    {
      id: "typescript",
      label: "TypeScript",
      description:
        "Типизация, дженерики, утилитарные типы, декораторы и лучшие практики",
    },
    {
      id: "react",
      label: "React",
      description:
        "JSX, хуки, паттерны, оптимизация производительности, архитектура компонентов",
    },
    {
      id: "nextjs",
      label: "Next.js",
      description:
        "Роутинг, серверные компоненты, кэширование, деплой и оптимизация",
    },
    {
      id: "vue",
      label: "Vue",
      description:
        "SFC, Composition API, реактивность, Vue Router, TypeScript и экосистема",
    },
    {
      id: "testing",
      label: "Тестирование",
      description:
        "Unit, интеграционное и E2E тестирование, мокирование, визуальное тестирование",
    },
    {
      id: "performance",
      label: "Производительность",
      description:
        "Метрики, виртуализация, hydration, web workers, архитектура браузера",
    },
    {
      id: "architecture",
      label: "Архитектура",
      description:
        "Паттерны проектирования, SOLID, DRY/KISS/YAGNI, BFF, MVC/MVVM",
    },
    {
      id: "state-management",
      label: "Хранилища",
      description:
        "Redux, Zustand, TanStack Query, Pinia, клиентские хранилища данных",
    },
    {
      id: "api-communication",
      label: "Работа с API",
      description:
        "REST, GraphQL, WebSocket, HTTP-клиенты, long polling, коды ответов",
    },
    {
      id: "build-and-deployment",
      label: "Сборка и деплой",
      description: "Сборка бандлов, CI/CD, деплой платформ, стратегии деплоя",
    },
    {
      id: "html-css",
      label: "HTML и CSS",
      description:
        "Семантика, CSS-методологии, flexbox, grid, анимации, адаптивность",
    },
    {
      id: "security",
      label: "Безопасность",
      description:
        "XSS, CSRF, CSP, аутентификация, HTTP-заголовки, supply chain",
    },
    {
      id: "ai",
      label: "AI и LLM",
      description:
        "Ментальная модель LLM, паттерны промптинга, агенты, RAG, streaming UI и безопасность",
    },
  ];

  return sections.map((s) => ({
    params: { section: s.id },
    props: { section: s },
  }));
}

const { section } = Astro.props;
const description = parseSectionDescription(section.id, section.label);
const articles = await getCollection(section.id as any);
const totalQuestions = articles.reduce(
  (sum: number, a: any) => sum + (a.data.questions?.length || 0),
  0,
);

const articleMap = new Map(
  articles.map((article: any) => [normalizeSlug(article.id), article]),
);

const referencedIds = new Set<string>();

function resolveArticle(slug: string): any | undefined {
  const normalized = normalizeSlug(slug);
  referencedIds.add(normalized);
  return articleMap.get(normalized);
}

const groups = parseSectionReadme(section.id).map((group) => {
  const directItems = group.slugs
    .map((slug) => resolveArticle(slug))
    .filter(Boolean)
    .map((article) => ({
      article,
      href: withBase(`/${section.id}/${article.id}`),
    }));

  const subgroups = group.subgroups
    .map((subgroup) => ({
      title: subgroup.title,
      items: subgroup.slugs
        .map((slug) => resolveArticle(slug))
        .filter(Boolean)
        .map((article) => ({
          article,
          href: withBase(`/${section.id}/${article.id}`),
        })),
    }))
    .filter((subgroup) => subgroup.items.length > 0);

  return {
    title: group.title,
    items: directItems,
    subgroups,
  };
});

const otherArticles = articles
  .filter((article: any) => !referencedIds.has(normalizeSlug(article.id)))
  .map((article: any) => ({
    article,
    href: withBase(`/${section.id}/${article.id}`),
  }));

if (otherArticles.length > 0) {
  groups.push({
    title: "Остальные",
    items: otherArticles,
    subgroups: [],
  });
}
---

<PageLayout
  title={section.label}
  description={description}
  currentSection={section.id}
  showLeftSidebar={true}
  showFooter={false}
>
  <Sidebar currentSection={section.id} slot="left-sidebar" />

  <div class="mx-auto max-w-5xl px-4 py-10 lg:px-8 lg:py-14">
    <div class="">
      <Breadcrumbs
        items={[
          { label: "Главная", href: withBase("/") },
          { label: section.label },
        ]}
      />

      <header class="mt-6 mb-10 border-b-[3px] border-border pb-6">
        <h1
          class="font-mono text-3xl text-text sm:text-5xl leading-tight tracking-tight font-extrabold uppercase"
        >
          {section.label}
        </h1>
        <p
          class="mt-3 text-sm font-bold uppercase tracking-wide text-text-secondary"
        >
          {description}
        </p>
        <div
          class="mt-4 flex items-center gap-3 font-mono text-xs font-bold uppercase tracking-wider text-text-tertiary"
        >
          <span class="border-2 border-border px-2 py-1 bg-surface"
            >{articles.length} статей</span
          >
          <span class="border-2 border-border px-2 py-1 bg-surface"
            >{totalQuestions} вопросов</span
          >
        </div>
      </header>
    </div>

    <div class="space-y-10">
      {
        groups.map((group) => (
          <ArticleGroup
            title={group.title}
            items={group.items}
            subgroups={group.subgroups}
          />
        ))
      }
    </div>
  </div>
</PageLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );

  document
    .querySelectorAll(".animate-fade-in")
    .forEach((el) => observer.observe(el));
</script>
