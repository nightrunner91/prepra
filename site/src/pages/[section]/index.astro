---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import ArticleCard from '../../components/content/ArticleCard.astro';
import Badge from '../../components/ui/Badge.astro';

export async function getStaticPaths() {
  const sections = [
    { id: 'javascript', label: 'JavaScript', description: 'Основы JavaScript, ES6+, замыкания, прототипы, асинхронность и многое другое' },
    { id: 'typescript', label: 'TypeScript', description: 'Типизация, дженерики, утилитарные типы, декораторы и лучшие практики' },
    { id: 'react', label: 'React', description: 'Хуки, паттерны, оптимизация производительности, архитектура компонентов' },
    { id: 'nextjs', label: 'Next.js', description: 'Роутинг, серверные компоненты, кэширование, деплой и оптимизация' },
    { id: 'testing', label: 'Testing', description: 'Unit, integration, E2E тестирование, мокирование, визуальное тестирование' },
    { id: 'performance', label: 'Performance', description: 'Метрики, виртуализация, hydration, web workers, архитектура браузера' },
    { id: 'architecture', label: 'Architecture', description: 'Паттерны проектирования, SOLID, DRY/KISS/YAGNI, BFF, MVC/MVVM' },
    { id: 'state-management', label: 'State Management', description: 'Zustand, TanStack Query, клиентские хранилища данных' },
    { id: 'algorithms', label: 'Algorithms', description: 'Алгоритмическая сложность, Big O, структуры данных' },
    { id: 'api-communication', label: 'API Communication', description: 'REST, GraphQL, WebSocket, HTTP-клиенты, long polling' },
    { id: 'build-and-deployment', label: 'Build & Deployment', description: 'Сборка бандлов, CI/CD, деплой платформ, стратегии деплоя' },
    { id: 'html-css', label: 'HTML & CSS', description: 'Семантика, CSS-методологии, flexbox, grid, анимации, адаптивность' },
    { id: 'platforms', label: 'Platforms', description: 'PWA, React Native, Preact и другие платформы' },
    { id: 'security', label: 'Security', description: 'XSS, CSRF, CSP, аутентификация, HTTP-заголовки, supply chain' },
  ];

  return sections.map((s) => ({
    params: { section: s.id },
    props: { section: s },
  }));
}

const { section } = Astro.props;
const articles = await getCollection(section.id as any);
const sorted = articles.sort((a, b) => a.data.order - b.data.order);
const totalQuestions = sorted.reduce((sum: number, a: any) => sum + (a.data.questions?.length || 0), 0);
---

<BaseLayout title={section.label} description={section.description} currentSection={section.id}>
  <div class="flex">
    <Sidebar currentSection={section.id} />

    <div class="flex-1 min-w-0">
      <div class="mx-auto max-w-3xl px-4 py-10 lg:px-8 lg:py-14">
        <div class="animate-fade-in">
          <Breadcrumbs items={[
            { label: 'Главная', href: '/' },
            { label: section.label },
          ]} />

          <header class="mt-6 mb-10">
            <h1 class="font-serif text-3xl text-text sm:text-4xl leading-tight tracking-tight">
              {section.label}
            </h1>
            <p class="mt-3 text-text-secondary leading-relaxed">{section.description}</p>
            <div class="mt-4 flex items-center gap-4 font-mono text-[11px] text-text-tertiary">
              <span>{sorted.length} статей</span>
              <span class="text-border">/</span>
              <span>{totalQuestions} вопросов</span>
            </div>
          </header>
        </div>

        <div class="space-y-3">
          {sorted.map((article: any, i: number) => (
            <div class="animate-fade-in" style={`animation-delay: ${i * 50}ms`}>
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={`/${section.id}/${article.slug}`}
                order={article.data.order}
                tags={article.data.tags}
                questionCount={article.data.questions?.length || 0}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.animate-fade-in').forEach((el) => observer.observe(el));
</script>
