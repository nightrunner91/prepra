---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Breadcrumbs from "../../components/layout/Breadcrumbs.astro";
import Sidebar from "../../components/layout/Sidebar.astro";
import TableOfContents from "../../components/content/TableOfContents.astro";
import PrevNextNav from "../../components/content/PrevNextNav.astro";
import { ReadingProgress } from "../../components/content/ReadingProgress";
import { QuizOverlay } from "../../components/content/QuizOverlay";
import Badge from "../../components/ui/Badge.astro";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  const collections = [
    "javascript",
    "typescript",
    "react",
    "nextjs",
    "testing",
    "performance",
    "architecture",
    "state-management",
    "api-communication",
    "build-and-deployment",
    "html-css",
    "security",
    "ai",
  ];

  const entries: CollectionEntry<string>[] = [];
  for (const col of collections) {
    const items = await getCollection(col as any);
    entries.push(...items);
  }

  return entries.map((entry) => ({
    params: { section: entry.collection, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const SECTION_LABELS: Record<string, string> = {
  javascript: "JavaScript",
  typescript: "TypeScript",
  react: "React",
  nextjs: "Next.js",
  testing: "Testing",
  performance: "Performance",
  architecture: "Architecture",
  "state-management": "State Management",
  "api-communication": "API Communication",
  "build-and-deployment": "Build & Deployment",
  "html-css": "HTML & CSS",
  security: "Security",
};

const sectionLabel = SECTION_LABELS[data.section] || data.section;

const allSectionArticles = (await getCollection(data.section as any)).sort(
  (a: any, b: any) => a.data.order - b.data.order,
);

const currentIdx = allSectionArticles.findIndex((a: any) => a.id === entry.id);
const prevArticle = currentIdx > 0 ? allSectionArticles[currentIdx - 1] : null;
const nextArticle =
  currentIdx < allSectionArticles.length - 1
    ? allSectionArticles[currentIdx + 1]
    : null;

const prev = prevArticle
  ? {
      title: prevArticle.data.title,
      href: withBase(`/${data.section}/${prevArticle.id}`),
    }
  : null;

const next = nextArticle
  ? {
      title: nextArticle.data.title,
      href: withBase(`/${data.section}/${nextArticle.id}`),
    }
  : null;

const { headings } = await render(entry);
---

<PageLayout
  title={data.title}
  description={data.description}
  currentSection={data.section}
  showLeftSidebar={true}
  showRightSidebar={true}
>
  <ReadingProgress client:load />

  <Sidebar currentSection={data.section} slot="left-sidebar" />
  <TableOfContents headings={headings} slot="right-sidebar" />

  <article class="mx-auto max-w-4xl px-4 py-10 lg:px-8 lg:py-14 w-full">
    <div class="mb-8">
      <Breadcrumbs
        items={[
          { label: "Главная", href: withBase("/") },
          { label: sectionLabel, href: withBase(`/${data.section}`) },
          { label: data.title },
        ]}
      />
    </div>

    {
      data.tags && data.tags.length > 0 && (
        <div class="mb-6 flex flex-wrap gap-2">
          {data.tags.map((tag: string) => (
            <Badge label={tag} size="xs" />
          ))}
        </div>
      )
    }

    <div class="prose prose-gray max-w-none prose-headings:scroll-mt-20">
      <Content />
    </div>

    {
      data.questions && data.questions.length > 0 && (
        <QuizOverlay
          client:only="react"
          questions={data.questions}
          articleId={withBase(`/${data.section}/${entry.id}`)}
        />
      )
    }

    <button
      id="read-toggle"
      type="button"
      class="mt-10 w-full flex items-center justify-center border-[3px] border-border bg-surface-alt px-6 py-3 font-mono font-bold uppercase tracking-wider text-text-secondary transition-all hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_#000000] dark:hover:shadow-[4px_4px_0px_#ffffff] active:translate-x-0 active:translate-y-0 active:shadow-none"
    >
      Отметить прочитанным
    </button>

    <PrevNextNav
      prev={prev}
      next={next}
      sectionLabel={sectionLabel}
      sectionHref={withBase(`/${data.section}`)}
    />
  </article>
</PageLayout>

<script>
  import "@phosphor-icons/web/regular";

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );

  document
    .querySelectorAll(".animate-fade-in")
    .forEach((el) => observer.observe(el));

  const STORAGE_KEY = "prepra:read-articles";
  const articleId = window.location.pathname.replace(/\/+$/, "");
  const btn = document.getElementById("read-toggle") as HTMLButtonElement;

  function getReadArticles(): string[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
    } catch {
      return [];
    }
  }

  function applyState(isRead: boolean) {
    if (isRead) {
      btn.innerHTML =
        '<i class="ph ph-check" style="margin-right:6px"></i>Прочитано';
      btn.classList.add(
        "!bg-pale-green-bg-hover",
        "!text-pale-green-text-hover",
        "!border-pale-green-text",
        "!shadow-none",
      );
    } else {
      btn.textContent = "Отметить прочитанным";
      btn.classList.remove(
        "!bg-pale-green-bg-hover",
        "!text-pale-green-text-hover",
        "!border-pale-green-text",
        "!shadow-none",
      );
    }
  }

  const readArticles = getReadArticles();
  applyState(readArticles.includes(articleId));

  btn.addEventListener("click", () => {
    const current = getReadArticles();
    const idx = current.indexOf(articleId);
    if (idx === -1) {
      current.push(articleId);
    } else {
      current.splice(idx, 1);
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(current));
    applyState(idx === -1);
  });
</script>
