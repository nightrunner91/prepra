---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MockInterview } from "../components/interview/MockInterview";
import { getMockInterviewSummary } from "../lib/mock-interview/build";

const { questionCount, sectionCount } = await getMockInterviewSummary();
---

<BaseLayout
  title="Интервью"
  description="Интервью: прогон в формате собеседования по фронтенду — вопросы из разных разделов, ответы вслух, самопроверка и разбор слабых тем в конце. Бесплатно и без регистрации."
  theme="interview"
>
  <div class="page-shell">
    <MockInterview
      client:load
      questionCount={questionCount}
      sectionCount={sectionCount}
    />
  </div>
</BaseLayout>
