---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionShell from "../components/layout/SectionShell.astro";
import SectionsGrid from "../components/content/SectionsGrid.astro";
import SectionProgress from "../components/content/SectionProgress.astro";
import { plural } from "../lib/plural";
import { getSectionStats, getTotals } from "../lib/section-overview";
import { getTheoryIndex } from "../lib/theory-index";
import { withBase } from "../lib/urls";

const sectionStats = await getSectionStats();
const { articleCount, questionCount, sectionCount } = getTotals(sectionStats);
const theoryIndex = await getTheoryIndex();
const firstArticleHref = theoryIndex[0]?.href ?? withBase("/javascript");

const stats = [
  {
    value: sectionCount,
    label: plural(sectionCount, "раздел", "раздела", "разделов"),
  },
  {
    value: articleCount,
    label: plural(articleCount, "статья", "статьи", "статей"),
  },
  {
    value: questionCount,
    label: plural(questionCount, "вопрос", "вопроса", "вопросов"),
  },
];
---

<BaseLayout
  title="Теория"
  description="Статьи для подготовки к техническому собеседованию: JavaScript, TypeScript, браузер и UI, React, Next.js, Node.js, System Design, тестирование, производительность, безопасность и AI."
>
  <SectionShell
    title="Теория"
    lede="Теоретическая база разработки: от основ Javascript до системного дизайна."
    stats={stats}
  >
    <SectionProgress
      slot="aside"
      totalArticles={articleCount}
      totalQuestions={questionCount}
      firstArticleHref={firstArticleHref}
      indexUrl={withBase("/theory-index.json")}
      practiceHref={withBase("/practice")}
    />

    <SectionsGrid sections={sectionStats} />
  </SectionShell>
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );

  document
    .querySelectorAll(".animate-fade-in")
    .forEach((el) => observer.observe(el));
</script>
