---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SectionCard from "../components/content/SectionCard.astro";
import FAQ from "../components/content/FAQ.astro";
import { sections } from "../lib/sections";
import { withBase } from "../lib/urls";

const sectionDescriptions: Record<string, string> = {
  javascript: "Основы JavaScript, ES6+, замыкания, прототипы, асинхронность",
  typescript: "Типизация, дженерики, утилитарные типы, декораторы",
  react: "Хуки, паттерны, оптимизация, архитектура компонентов",
  nextjs: "Роутинг, серверные компоненты, кэширование, деплой",
  testing: "Unit, integration, E2E тестирование, мокирование",
  "html-css": "Семантика, CSS-методологии, flexbox, grid, адаптивность",
  performance: "Метрики, виртуализация, hydration, web workers",
  architecture: "Паттерны проектирования, SOLID, DRY/KISS/YAGNI, BFF",
  "state-management": "Zustand, TanStack Query, клиентские хранилища",
  "api-communication": "REST, GraphQL, WebSocket, HTTP-клиенты",
  "build-and-deployment": "Сборка бандлов, CI/CD, стратегии деплоя",
  security: "XSS, CSRF, CSP, аутентификация, HTTP-заголовки",
  ai: "Ментальная модель, паттерны промптинга, агенты, RAG",
};

const sectionColors: Record<string, "red" | "blue" | "green" | "yellow"> = {
  javascript: "yellow",
  typescript: "blue",
  react: "blue",
  nextjs: "neutral",
  testing: "green",
  "html-css": "red",
  performance: "green",
  architecture: "neutral",
  "state-management": "blue",
  "api-communication": "green",
  "build-and-deployment": "neutral",
  security: "red",
  ai: "green",
};

const sectionStats = await Promise.all(
  sections.map(async (s) => {
    const articles = await getCollection(s.id as any);
    const totalQuestions = articles.reduce(
      (sum, a) => sum + (a.data.questions?.length || 0),
      0,
    );
    return {
      ...s,
      description: sectionDescriptions[s.id] || "",
      color: sectionColors[s.id] || "neutral",
      articleCount: articles.length,
      questionCount: totalQuestions,
    };
  }),
);

const totalArticles = sectionStats.reduce((sum, s) => sum + s.articleCount, 0);
const totalQuestions = sectionStats.reduce(
  (sum, s) => sum + s.questionCount,
  0,
);

const faqItems = [
  {
    question: "Для кого создана prepra?",
    answer:
      "<p>Для фронтенд-разработчиков уровня Middle и Senior, которые готовятся к техническим собеседованиям в 2026–2027 году.</p>",
  },
  {
    question: "Подойдёт ли prepra начинающим?",
    answer:
      "<p>Если ты только начинаешь путь во фронтенде — честно, материал будет сложноват. Prepra рассчитана на разработчиков с опытом, которые хотят систематизировать знания.</p>",
  },
  {
    question: "Чем prepra отличается от других ресурсов?",
    answer:
      "<p>Prepra — это не сборник статей, а готовый roadmap подготовки к собеседованию с системой самопроверки и повторения. Каждый раздел идёт в логичном порядке, прогресс сохраняется.</p>",
  },
  {
    question: "Как лучше использовать prepra?",
    answer:
      "<p>Советую начать с базы — <a href='#'>Javascript</a> и проходить темы <strong>последовательно</strong>, не перепрыгивая. Материал намеренно подаётся каскадом по мере углубления во фронтэнд и статьи логично связаны.</p>",
  },
  {
    question: "Какие темы покрывают материалы prepra?",
    answer:
      "Всё что касается актуальной фронтэнд разработки: от основ Javascript до применения ИИ. Основной упор на React и Vue. Много теории об архитектуре приложений, безопасности и тестировании.",
  },
  {
    question: "Нужно ли регистрироваться на prepra?",
    answer:
      "<p>Нет. Но без регистрации прогресс хранится только в браузере. Хочешь синхронизацию между устройствами — <a href='#'>зарегистрируйся</a>, это быстро.</p>",
  },
  {
    question: "За использование prepra нужно платить?",
    answer:
      "<p>Нет, prepra полностью бесплатна. Но если хочешь отблагодарить — <a href='#'>криптокошелёк</a> к твоим услугам, не откажусь.</p>",
  },
  {
    question: "Зачем мне prepra, если есть ChatGPT?",
    answer:
      "<p>ИИ не даёт структуры, может ошибаться и давать устаревшую информацию. На prepra материалы систематизированы, проверены и собраны в одном месте — это готовый план, а не хаотичный диалог.</p>",
  },
  {
    question: "Как часто здесь обновляются статьи?",
    answer:
      "<p>Фронтэнд стремительно меняется — и я регулярно добавляю новые темы и обновляю существующие. Обновления не реже раза в месяц.</p>",
  },
  {
    question: "Можно ли предложить тему или сообщить об ошибке?",
    answer:
      "<p>Да! <a href='#'>Пиши в Telegram</a> или <a href='#'>создай issue</a> на GitHub — разберусь.</p>",
  },
  {
    question: "Есть ли мобильная версия?",
    answer:
      "<p>Да, сайт полностью адаптивен — можно готовиться с телефона в дороге.</p>",
  },
  {
    question: "Планируется ли добавление других языков?",
    answer: "<p>Сейчас prepra доступна только на русском языке.</p>",
  },
];
---

<PageLayout title="Главная">
  <div class="mx-auto max-w-7xl px-4 py-12 lg:py-16 lg:px-8">
    <div class="">
      <h1
        class="font-serif text-4xl text-text sm:text-5xl lg:text-7xl leading-[1.1] tracking-tight font-medium"
      >
        <span class="text-text">pre</span><span class="text-pale-green-text"
          >pra</span
        >.
      </h1>
      <p class="mt-4 text-lg text-text-secondary leading-relaxed">
        Интерактивная платформа для подготовки к фронтенд-собеседованию.
      </p>
      <div
        class="mt-6 flex items-center gap-4 font-mono text-sm text-text-tertiary"
      >
        <span>{totalArticles} статей</span>
        <span class="text-border">/</span>
        <span>{totalQuestions} вопросов</span>
        <span class="text-border">/</span>
        <span>{sections.length} разделов</span>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        sectionStats.map((s, i) => (
          <div class="animate-fade-in" style={`animation-delay: ${i * 60}ms`}>
            <SectionCard
              title={s.label}
              description={s.description}
              href={withBase(`/${s.id}`)}
              articleCount={s.articleCount}
              questionCount={s.questionCount}
              color={s.color}
              icon={s.icon}
            />
          </div>
        ))
      }
    </div>

    <div class="mt-20 lg:mt-24">
      <FAQ items={faqItems} />
    </div>
  </div>
</PageLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );

  document
    .querySelectorAll(".animate-fade-in")
    .forEach((el) => observer.observe(el));
</script>
