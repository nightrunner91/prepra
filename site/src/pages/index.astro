---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/content/Hero.astro";
import StatsBand from "../components/content/StatsBand.astro";
import SectionIndex from "../components/content/SectionIndex.astro";
import PreparationModes from "../components/content/PreparationModes.astro";
import HowItWorks from "../components/content/HowItWorks.astro";
import DailyQuestion from "../components/content/DailyQuestion.astro";
import FAQ from "../components/content/FAQ.astro";
import { withBase } from "../lib/urls";
import {
  getDailyQuestion,
  getSectionStats,
  getTotals,
} from "../lib/section-overview";
import { TASKS } from "../lib/practice";
import { PRESETS } from "../lib/mock-interview/presets";

const sectionStats = await getSectionStats();
const { articleCount, questionCount, sectionCount } = getTotals(sectionStats);
const dailyQuestion = await getDailyQuestion(sectionStats);

const taskCount = TASKS.length;
const presetCount = PRESETS.length;

const legacyHashRoutes: Record<string, string> = {
  theory: withBase("/theory"),
  practice: withBase("/practice"),
  interview: withBase("/interview"),
};

const faqItems = [
  {
    question: "Для кого создана prepra?",
    answer:
      "<p>Для фронтенд-разработчиков уровня Middle и Senior, которые готовятся к техническим собеседованиям и хотят систематизировать знания. Если ты только начинаешь путь во фронтенде, материал местами будет сложноват: желателен хотя бы небольшой опыт разработки.</p>",
  },
  {
    question: "Нужно ли регистрироваться и сколько это стоит?",
    answer:
      "<p>Регистрация не нужна. prepra распространяется как открытый проект и полностью бесплатен. Прогресс хранится только в памяти браузера (localStorage).</p>",
  },
  {
    question: "Как лучше использовать prepra?",
    answer: `<p>Советую начать с базы: <a href='${withBase("/javascript")}'>JavaScript</a>, и проходить темы <strong>последовательно</strong>, не перепрыгивая. Материал подаётся каскадом по мере углубления во фронтенд. У каждой статьи есть практическая часть для самопроверки, не пропускай её. Закрепляй темы в <a href='${withBase("/practice")}'>практикуме</a>, а когда будешь готов, пройди первое <a href='${withBase("/interview")}'>мок-интервью</a>.</p>`,
  },
  {
    question: "Что такое мок-интервью?",
    answer: `<p>Это режим самопроверки, в котором вопросы собираются из разных разделов сразу, как на настоящем техническом интервью. Ты отвечаешь вслух, оцениваешь себя после каждого вопроса, а в конце получаешь таблицу по разделам и ссылку на самую слабую тему. Доступно на <a href='${withBase("/interview")}'>отдельной странице</a> без регистрации.</p>`,
  },
  {
    question: "Чем практикум отличается от мок-интервью?",
    answer: `<p>Практикум: банк задач с проверкой, «что выведет код», выбор ответа и задачи с автотестами. Мок-интервью: режим устной самопроверки, где ты отвечаешь вслух и сам оцениваешь ответ. Сначала закрепляй базу в <a href='${withBase("/practice")}'>практикуме</a>, затем проверяй себя на <a href='${withBase("/interview")}'>мок-интервью</a>.</p>`,
  },
  {
    question: "Какие темы покрывают материалы prepra?",
    answer:
      "Материалы идут от основ JavaScript и браузера к React, Next.js, System Design и инфраструктуре. Основной упор на React и Next.js, Vue остаётся вторым стеком. Разделы по Node.js, базам данных и инженерным практикам появляются по мере выхода статей.",
  },
  {
    question: "Зачем мне prepra, если есть ChatGPT?",
    answer:
      "<p>ИИ не даёт структуры и может давать устаревшую информацию. На prepra материалы систематизированы, проверены и собраны в одном месте: это готовый план, а не спонтанный диалог.</p>",
  },
];
---

<BaseLayout
  title="Подготовка к фронтенд-собеседованию"
  description="Теория, задачи и мок-интервью в одном треке: 14 разделов от JavaScript и браузера до React, Next.js и System Design."
>
  <script is:inline define:vars={{ legacyHashRoutes }}>
    (() => {
      const id = window.location.hash.replace("#", "");
      const target = legacyHashRoutes[id];
      if (!target) return;
      window.location.replace(target + window.location.search);
    })();
  </script>

  <Hero />

  <StatsBand
    sectionCount={sectionCount}
    articleCount={articleCount}
    questionCount={questionCount}
    taskCount={taskCount}
  />

  <div class="mx-auto max-w-[1600px] px-6 pb-16 lg:px-12 lg:pb-20">
    <SectionIndex sections={sectionStats} />

    <PreparationModes
      articleCount={articleCount}
      taskCount={taskCount}
      presetCount={presetCount}
    />

    <HowItWorks />

    {
      dailyQuestion && (
        <DailyQuestion
          question={dailyQuestion}
          questionCount={questionCount}
        />
      )
    }

    <FAQ items={faqItems} />
  </div>
</BaseLayout>
