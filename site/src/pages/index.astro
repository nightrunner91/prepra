---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/content/Hero.astro";
import StatsBand from "../components/content/StatsBand.astro";
import SectionIndex from "../components/content/SectionIndex.astro";
import PreparationModes from "../components/content/PreparationModes.astro";
import HowItWorks from "../components/content/HowItWorks.astro";
import DailyQuestion from "../components/content/DailyQuestion.astro";
import FAQ from "../components/content/FAQ.astro";
import FinalCta from "../components/content/FinalCta.astro";
import { withBase } from "../lib/urls";
import {
  getDailyQuestion,
  getSectionStats,
  getTotals,
} from "../lib/section-overview";
import { TASKS } from "../lib/practice";
import { PRESETS } from "../lib/mock-interview/presets";

const sectionStats = await getSectionStats();
const { articleCount, questionCount, sectionCount } = getTotals(sectionStats);
const dailyQuestion = await getDailyQuestion(sectionStats);

const taskCount = TASKS.length;
const presetCount = PRESETS.length;

const legacyHashRoutes: Record<string, string> = {
  theory: withBase("/theory"),
  practice: withBase("/practice"),
  interview: withBase("/interview"),
};

const faqItems = [
  {
    question: "Для кого создана Prepra?",
    answer:
      "<p>Для фронтенд-разработчиков уровня Middle и Senior, которые готовятся к техническим собеседованиям и хотят систематизировать знания.</p>",
  },
  {
    question: "Подойдёт ли Prepra начинающим?",
    answer:
      "<p>Подойдёт. Но буду честен: местами материал будет сложен для понимания — желателен хотя бы небольшой опыт разработки.</p>",
  },
  {
    question: "Нужно ли регистрироваться и сколько это стоит?",
    answer:
      "<p>Регистрация не нужна. Prepra распространяется как открытый проект и полностью бесплатна. Прогресс хранится только в памяти браузера (localStorage).</p>",
  },
  {
    question: "Что будет с прогрессом, если почистить кэш или зайти с другого устройства?",
    answer:
      "<p>Прогресс хранится только в браузере (localStorage) и никуда не отправляется. Поэтому очистка данных браузера, режим инкогнито или другое устройство — и прогресс начнётся заново. Синхронизации между устройствами нет, зато данные никуда не утекают.</p>",
  },
  {
    question: "Зачем мне Prepra, если есть ChatGPT / Claude?",
    answer:
      "<p>Чат с ИИ отвечает на отдельный вопрос, но не даёт трека, прогресса и проверки. На Prepra материалы собраны в разделы, у каждой статьи есть вопросы для самопроверки, задачи проверяются автоматически, а режим интервью показывает слабые темы. ИИ хорошо объясняет — Prepra помогает дойти до собеседования.</p>",
  },
  {
    question: "Как лучше использовать Prepra?",
    answer: `<p>Советую начать с базы — <a href='${withBase("/javascript")}'>JavaScript</a> — и проходить темы <strong>последовательно</strong>. Не обязательно читать всё подряд: добавляй разделы под свою вакансию. У каждой статьи есть вопросы для самопроверки, не пропускай их. Закрепляй темы в <a href='${withBase("/practice")}'>практике</a>, а когда будешь готов, пройди первое <a href='${withBase("/interview")}'>интервью</a>.</p>`,
  },
  {
    question: "Что такое практика?",
    answer: `<p>Практика — это банк задач по JavaScript трёх уровней: Junior, Middle и Senior. Есть два формата: «что выведет код» с выбором ответа и задачи на код с автотестами, которые выполняются прямо в браузере. У каждой задачи есть разбор ответа и ссылка на теорию по теме, а прогресс хранится локально и не требует регистрации. Открыть можно на <a href='${withBase("/practice")}'>отдельной странице</a>.</p>`,
  },
  {
    question: "Что такое интервью?",
    answer: `<p>Интервью — это формат самопроверки, а не симуляция с интервьюером: вопросы собираются из разных разделов сразу, как на настоящем техническом собеседовании. Ты отвечаешь вслух, сам оцениваешь каждый ответ, а в конце получаешь таблицу по разделам и ссылку на самую слабую тему. Доступно на <a href='${withBase("/interview")}'>отдельной странице</a> без регистрации.</p>`,
  },
  {
    question: "Какие темы разбираются на Prepra?",
    answer:
      "Основной язык — JavaScript/TypeScript, а по фронтенду рассматриваются React и Vue вместе с их метафреймворками (Next.js и Nuxt). Бэкенд-часть — Node.js и PostgreSQL для общего ознакомления. Отдельно разбираются общие инженерные принципы: тестирование, инфраструктура, безопасность и System Design. Завершается всё практическим применением ИИ.",
  },
  {
    question: "Можно ли доверять материалам?",
    answer:
      "<p>Каждую статью автор проверяет вручную, материал сверяется с официальной документацией и спецификациями. Ссылки на источники есть в конце каждой статьи. Если заметил неточность — <a href='https://t.me/nightrunner91'>напиши</a> мне, поправлю.</p>",
  },
  {
    question: "Как часто обновляется проект?",
    answer:
      "<p>Еженедельно: новые статьи, задачи и правки существующих материалов. Сейчас развиваются разделы по Node.js и PostgreSQL, а также банк практики.</p>",
  },
  {
    question: "Проект открытый? Можно ли помочь?",
    answer:
      "<p>Да, Prepra — открытый проект на <a href='https://github.com/nightrunner91/prepra'>GitHub</a> под лицензией AGPL-3.0. Можно предложить правку, добавить статью или задачу, сообщить об ошибке.</p>",
  },
];

const siteUrl = Astro.site ?? new URL("https://nightrunner91.github.io");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Prepra",
    url: new URL(withBase("/"), siteUrl).href,
    inLanguage: "ru",
    description:
      "Подготовка к собеседованию фронтенд-разработчика: теория, задачи и интервью.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
          .replace(/<[^>]+>/g, "")
          .replace(/\s+/g, " ")
          .trim(),
      },
    })),
  },
];
---

<BaseLayout
  title="Подготовка к собеседованию фронтенд-разработчика"
  description="Теория, задачи и интервью для подготовки к фронтенд-собеседованию: JavaScript, React, Next.js и System Design. Бесплатно, без регистрации."
  jsonLd={jsonLd}
>
  <script is:inline define:vars={{ legacyHashRoutes }}>
    (() => {
      const id = window.location.hash.replace("#", "");
      const target = legacyHashRoutes[id];
      if (!target) return;
      window.location.replace(target + window.location.search);
    })();
  </script>

  <Hero />

  <StatsBand
    sectionCount={sectionCount}
    articleCount={articleCount}
    questionCount={questionCount}
    taskCount={taskCount}
  />

  <div class="mx-auto max-w-[1600px] px-6 lg:px-12">
    <SectionIndex sections={sectionStats} />

    <PreparationModes
      articleCount={articleCount}
      taskCount={taskCount}
      sectionCount={sectionCount}
      presetCount={presetCount}
    />
  </div>

  <HowItWorks />

  <div class="mx-auto max-w-[1600px] px-6 pb-16 lg:px-12 lg:pb-20">
    {
      dailyQuestion && (
        <DailyQuestion question={dailyQuestion} questionCount={questionCount} />
      )
    }

    <FAQ items={faqItems} />
  </div>

  <FinalCta />
</BaseLayout>
