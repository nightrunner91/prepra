---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/content/Hero.astro";
import SectionsGrid from "../components/content/SectionsGrid.astro";
import ProgressBlock from "../components/content/ProgressBlock.astro";
import HowItWorks from "../components/content/HowItWorks.astro";
import DailyQuestion from "../components/content/DailyQuestion.astro";
import FAQ from "../components/content/FAQ.astro";
import Footer from "../components/layout/Footer.astro";
import { sections } from "../lib/sections";

const sectionDescriptions: Record<string, string> = {
  javascript: "Основы JavaScript, ES6+, замыкания, прототипы, асинхронность",
  typescript: "Типизация, дженерики, утилитарные типы, декораторы",
  react: "Хуки, паттерны, оптимизация, архитектура компонентов",
  nextjs: "Роутинг, серверные компоненты, кэширование, деплой",
  testing: "Unit, integration, E2E тестирование, мокирование",
  "html-css": "Семантика, CSS-методологии, flexbox, grid, адаптивность",
  performance: "Метрики, виртуализация, hydration, web workers",
  architecture: "Паттерны проектирования, SOLID, DRY/KISS/YAGNI, BFF",
  "state-management": "Zustand, TanStack Query, клиентские хранилища",
  "api-communication": "REST, GraphQL, WebSocket, HTTP-клиенты",
  "build-and-deployment": "Сборка бандлов, CI/CD, стратегии деплоя",
  security: "XSS, CSRF, CSP, аутентификация, HTTP-заголовки",
  ai: "Ментальная модель, паттерны промптинга, агенты, RAG",
};

const sectionColors: Record<string, "red" | "blue" | "green" | "yellow"> = {
  javascript: "yellow",
  typescript: "blue",
  react: "blue",
  nextjs: "neutral",
  testing: "green",
  "html-css": "red",
  performance: "green",
  architecture: "neutral",
  "state-management": "blue",
  "api-communication": "green",
  "build-and-deployment": "neutral",
  security: "red",
  ai: "green",
};

const sectionStats = await Promise.all(
  sections.map(async (s) => {
    const articles = await getCollection(s.id as any);
    const totalQuestions = articles.reduce(
      (sum, a) => sum + (a.data.questions?.length || 0),
      0,
    );
    return {
      ...s,
      description: sectionDescriptions[s.id] || "",
      color: sectionColors[s.id] || "neutral",
      articleCount: articles.length,
      questionCount: totalQuestions,
    };
  }),
);

const totalArticles = sectionStats.reduce((sum, s) => sum + s.articleCount, 0);
const totalQuestions = sectionStats.reduce(
  (sum, s) => sum + s.questionCount,
  0,
);

const allQuestions: { text: string; sectionId: string; articleSlug: string }[] =
  [];
for (const s of sectionStats) {
  const articles = await getCollection(s.id as any);
  for (const a of articles) {
    for (const q of a.data.questions || []) {
      allQuestions.push({ text: q, sectionId: s.id, articleSlug: a.id });
    }
  }
}

const today = new Date();
const dayOfYear = Math.floor(
  (today.getTime() - new Date(today.getFullYear(), 0, 0).getTime()) /
    (1000 * 60 * 60 * 24),
);
const dailyQuestion =
  allQuestions.length > 0
    ? allQuestions[dayOfYear % allQuestions.length]
    : null;

const faqItems = [
  {
    question: "Для кого создана prepra?",
    answer:
      "<p>Для фронтенд-разработчиков уровня Middle и Senior, которые готовятся к техническим собеседованиям в 2026-2027 году и хотят систематизировать знания.</p>",
  },
  {
    question: "Подойдёт ли prepra начинающим?",
    answer:
      "<p>Конечно. Но буду честен: если ты только-только начинаешь путь во фронтенде - материал местами будет сложноват. Желателен хотя бы небольшой опыт разработки.</p>",
  },
  {
    question: "Чем prepra отличается от других ресурсов?",
    answer:
      "<p>Prepra - это не сборник статей, а готовый roadmap подготовки к собеседованию с системой самопроверки и повторения. Каждый раздел идёт в логичном порядке, прогресс сохраняется. Всё полностью бесплатно.</p>",
  },
  {
    question: "Нужно ли регистрироваться?",
    answer:
      "<p>Нет. Но без регистрации прогресс хранится только в браузере. Хочешь синхронизацию между устройствами - <a href='#'>зарегистрируйся</a>, это быстро.</p>",
  },
  {
    question: "Нужно ли платить?",
    answer:
      "<p>Нет, prepra полностью бесплатна. Но если хочешь отблагодарить - <a href='#'>криптокошелёк</a> к твоим услугам, не откажусь.</p>",
  },
  {
    question: "Как лучше использовать prepra?",
    answer:
      "<p>Советую начать с базы - <a href='#'>Javascript</a> и проходить темы <strong>последовательно</strong>, не перепрыгивая. Материал намеренно подаётся каскадом по мере углубления во фронтэнд. У каждой статьи есть практическая часть для самопроверки - не пропускай её.</p>",
  },
  {
    question: "Какие темы покрывают материалы prepra?",
    answer:
      "Всё что касается актуальной фронтэнд разработки: от основ Javascript до применения ИИ. Основной упор на React и Vue. Много теории об архитектуре приложений, безопасности и тестировании.",
  },
  {
    question: "Зачем мне prepra, если есть ChatGPT?",
    answer:
      "<p>ИИ не даёт структуры и может давать устаревшую информацию. На prepra материалы систематизированы, проверены и собраны в одном месте - это готовый план, а не спонтанный диалог.</p>",
  },
  {
    question: "Как часто здесь обновляются статьи?",
    answer:
      "<p>Фронтэнд стремительно меняется - и я регулярно добавляю новые темы и обновляю существующие. Обновления не реже раза в месяц.</p>",
  },
];
---

<PageLayout title="Главная">
  <div class="mx-auto px-6 py-12 lg:py-16 lg:px-12">
    <Hero />

    <ProgressBlock
      totalArticles={totalArticles}
      totalQuestions={totalQuestions}
      sectionsCount={sections.length}
    />

    <SectionsGrid sections={sectionStats} />

    <HowItWorks />

    {dailyQuestion && <DailyQuestion question={dailyQuestion} />}

    <div class="mt-20 lg:mt-24 mb-12">
      <FAQ items={faqItems} />
    </div>
  </div>

  <Footer slot="footer" />
</PageLayout>

<style>
  .animate-fade-in {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .animate-fade-in.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );

  document
    .querySelectorAll(".animate-fade-in")
    .forEach((el) => observer.observe(el));
</script>
